26-01-14\": \"Makar Sankranti \ud83c\udf3e\",\n            \"2026-01-26\": \"Republic Day \ud83c\uddee\ud83c\uddf3\",\n            \"2026-02-15\": \"Maha Shivaratri \ud83d\udd31\",\n            \"2026-03-03\": \"Holi \ud83c\udfa8\",\n            \"2026-03-20\": \"Eid-ul-Fitr \ud83c\udf19\",\n            \"2026-03-27\": \"Rama Navami \ud83c\udff9\",\n            \"2026-05-28\": \"Eid-ul-Adha \ud83d\udd4b\",\n            \"2026-08-15\": \"Independence Day \ud83c\uddee\ud83c\uddf3\",\n            \"2026-08-28\": \"Raksha Bandhan \ud83c\udf81\",\n            \"2026-09-04\": \"Janmashtami \ud83e\ude88\",\n            \"2026-09-16\": \"Ganesh Chaturthi \ud83d\udc18\",\n            \"2026-10-02\": \"Gandhi Jayanti \ud83d\udd4a\ufe0f\",\n            \"2026-10-20\": \"Dussehra \ud83c\udff9\",\n            \"2026-11-08\": \"Diwali \ud83e\ude94\",\n            \"2026-11-24\": \"Guru Nanak Jayanti \ud83e\ude94\",\n            \"2026-12-25\": \"Christmas \ud83c\udf84\"\n        };\n\n        // \u2500\u2500\u2500 Live Clock & Target \u2500\u2500\u2500\n        function updateLiveWidgets() {\n            const now = new Date();\n            document.getElementById('live-clock-display').innerText = now.toLocaleTimeString();\n            document.getElementById('live-date-display').innerText = now.toLocaleDateString(undefined, { weekday: 'short',\n                month: 'short', day: 'numeric', year: 'numeric' });\n            let targetData = JSON.parse(localStorage.getItem(TARGET_KEY));\n            if (!targetData) {\n                targetData = { name: \"JEE 2028\", date: \"2028-01-21T09:00:00\" };\n                localStorage.setItem(TARGET_KEY, JSON.stringify(targetData));\n            }\n            document.getElementById('target-name-label').innerText = targetData.name;\n            const targetDate = new Date(targetData.date);\n            const diff = targetDate - now;\n            const el = document.getElementById('target-countdown-display');\n            if (diff <= 0) el.innerText = \"Target Reached! \ud83c\udf89\";\n            else {\n                const d = Math.floor(diff / 86400000);\n                const h = Math.floor((diff % 86400000) / 3600000);\n                const m = Math.floor((diff % 3600000) / 60000);\n                const s = Math.floor((diff % 60000) / 1000);\n                el.innerText = `${d}d ${h}h ${m}m ${s}s`;\n            }\n        }\n        setInterval(updateLiveWidgets, 1000);\n        updateLiveWidgets();\n\n        document.getElementById('target-widget-box').addEventListener('click', async () => {\n            const cur = JSON.parse(localStorage.getItem(TARGET_KEY)) || { name: \"JEE 2028\", date: \"2028-01-21T09:00:00\" };\n            const html = `\n                <label style=\"font-size:0.8rem; font-weight:700; color:var(--text-muted)\">Event / Target Name:</label>\n                <input type=\"text\" id=\"modal-target-name\" value=\"${cur.name}\">\n                <label style=\"font-size:0.8rem; font-weight:700; color:var(--text-muted)\">Target Date & Time:</label>\n                <input type=\"datetime-local\" id=\"modal-target-date\" value=\"${cur.date}\">\n            `;\n            const res = await openStickerModal(\"Set Exam / Target\", \"fas fa-bullseye\", html);\n            if (!res) return;\n            const nameVal = document.getElementById('modal-target-name').value;\n            const dateVal = document.getElementById('modal-target-date').value;\n            if (!nameVal || !dateVal) return;\n            const newTarget = { name: nameVal, date: dateVal };\n            localStorage.setItem(TARGET_KEY, JSON.stringify(newTarget));\n            showStickerToast(`\ud83c\udfaf Target updated to \"${nameVal}\"!`);\n            updateLiveWidgets();\n            if (currentUser && !currentUser.isAnonymous) await syncAllToCloud();\n        });\n\n        // \u2500\u2500\u2500 Firestore conversion \u2500\u2500\u2500\n        function convertRowsForFirestore(timetables) {\n            return timetables.map(entry => ({\n                date: entry.date,\n                headers: entry.headers,\n                rows: entry.rows.map(row => ({ cells: row }))\n            }));\n        }\n\n        function convertRowsFromFirestore(timetables) {\n            return timetables.map(entry => ({\n                date: entry.date,\n                headers: entry.headers,\n                rows: entry.rows.map(rowObj => rowObj.cells)\n            }));\n        }\n\n        // \u2500\u2500\u2500 CLOUD SYNC \u2500\u2500\u2500\n        function updateCloudStatus(state) {\n            cloudStatus.className = 'cloud-status';\n            if (state === 'online') { cloudStatus.classList.add('online');\n                cloudStatusText.innerText = 'Synced'; } else if (state === 'offline') { cloudStatus.classList.add('offline');\n                cloudStatusText.innerText = 'Offline'; } else if (state === 'syncing') { cloudStatus.classList.add('syncing');\n                cloudStatusText.innerText = 'Syncing...'; } else { cloudStatusText.innerText = 'Checking...'; }\n        }\n\n        async function syncAllToCloud() {\n            if (!currentUser || currentUser.isAnonymous || !isFirebaseReady) return false;\n            if (syncInProgress) { console.log('Sync already in progress'); return true; }\n            syncInProgress = true;\n            updateCloudStatus('syncing');\n            try {\n                const uid = currentUser.uid;\n                const rawTimetables = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n                const tests = JSON.parse(localStorage.getItem(TESTS_KEY)) || [];\n                const target = JSON.parse(localStorage.getItem(TARGET_KEY)) || { name: \"JEE 2028\",\n                    date: \"2028-01-21T09:00:00\" };\n                const tasks = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n                const timetablesForFirestore = convertRowsForFirestore(rawTimetables);\n                await db.collection('users').doc(uid).set({\n                    timetables: timetablesForFirestore,\n                    tests,\n                    target,\n                    tasks,\n                    updatedAt: firebase.firestore.FieldValue.serverTimestamp()\n                }, { merge: true });\n                updateCloudStatus('online');\n                return true;\n            } catch (e) {\n                console.warn('Push error:', e);\n                updateCloudStatus('offline');\n                showStickerToast(`\u26a0\ufe0f Push failed: ${e.message}`);\n                return false;\n            } finally { syncInProgress = false; }\n        }\n\n        async function pullFromCloud() {\n            if (!currentUser || currentUser.isAnonymous || !isFirebaseReady) return false;\n            if (syncInProgress) { await new Promise(r => setTimeout(r, 600)); return pullFromCloud(); }\n            syncInProgress = true;\n            updateCloudStatus('syncing');\n            try {\n                const docRef = db.collection('users').doc(currentUser.uid);\n                const doc = await docRef.get();\n                if (!doc.exists) {\n                    updateCloudStatus('online');\n                    showStickerToast('\ud83d\udced No data in cloud. Push your local data first.');\n                    syncInProgress = false;\n                    return false;\n                }\n                const data = doc.data();\n                if (data.timetables !== undefined && data.timetables !== null) {\n                    const converted = convertRowsFromFirestore(data.timetables);\n                    localStorage.setItem(TIMETABLE_KEY, JSON.stringify(converted));\n                } else {\n                    localStorage.setItem(TIMETABLE_KEY, JSON.stringify([]));\n                    await db.collection('users').doc(currentUser.uid).set({ timetables: [],\n                        updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });\n                }\n                if (data.tests !== undefined && data.tests !== null) {\n                    localStorage.setItem(TESTS_KEY, JSON.stringify(data.tests || []));\n                } else {\n                    localStorage.setItem(TESTS_KEY, JSON.stringify([]));\n                    await db.collection('users').doc(currentUser.uid).set({ tests: [],\n                        updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });\n                }\n                if (data.target) localStorage.setItem(TARGET_KEY, JSON.stringify(data.target));\n                if (data.tasks !== undefined && data.tasks !== null) {\n                    localStorage.setItem(TASKS_KEY, JSON.stringify(data.tasks || []));\n                } else {\n                    localStorage.setItem(TASKS_KEY, JSON.stringify([]));\n                    await db.collection('users').doc(currentUser.uid).set({ tasks: [],\n                        updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });\n                }\n                updateCloudStatus('online');\n                return true;\n            } catch (e) {\n                console.warn('Pull error:', e);\n                updateCloudStatus('offline');\n                showStickerToast(`\u26a0\ufe0f Pull failed: ${e.message}`);\n                return false;\n            } finally { syncInProgress = false; }\n        }\n\n        // \u2500\u2500\u2500 REAL-TIME SYNC (NEW FEATURE) \u2500\u2500\u2500\n        function setupRealtimeSync() {\n            // Clear existing listener if any\n            if (realtimeUnsubscribe) {\n                realtimeUnsubscribe();\n                realtimeUnsubscribe = null;\n            }\n\n            if (!currentUser || currentUser.isAnonymous || !isFirebaseReady) {\n                console.log('\u26a0\ufe0f Realtime sync: No authenticated user');\n                return;\n            }\n\n            console.log('\ud83d\udd04 Setting up real-time sync for user:', currentUser.uid);\n\n            try {\n                realtimeUnsubscribe = db.collection('users').doc(currentUser.uid)\n                    .onSnapshot({\n                        includeMetadataChanges: true\n                    }, (docSnapshot) => {\n                        if (!docSnapshot.exists) {\n                            console.log('\ud83d\udced No document exists yet');\n                            return;\n                        }\n\n                        // Only process if the data came from the server (not from local cache)\n                        const source = docSnapshot.metadata.fromCache ? 'local' : 'server';\n                        if (source === 'local') {\n                            console.log('\ud83d\udce6 Data from local cache, skipping...');\n                            return;\n                        }\n\n                        const data = docSnapshot.data();\n                        console.log('\ud83d\udd25 Real-time update received from server!', data);\n\n                        // Check what changed and update localStorage\n                        let hasChanges = false;\n\n                        if (data.timetables !== undefined && data.timetables !== null) {\n                            const converted = convertRowsFromFirestore(data.timetables);\n                            const current = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n                            if (JSON.stringify(converted) !== JSON.stringify(current)) {\n                                localStorage.setItem(TIMETABLE_KEY, JSON.stringify(converted));\n                                hasChanges = true;\n                                console.log('\ud83d\udcca Timetable updated from cloud');\n                            }\n                        }\n\n                        if (data.tests !== undefined && data.tests !== null) {\n                            const current = JSON.parse(localStorage.getItem(TESTS_KEY)) || [];\n                            if (JSON.stringify(data.tests) !== JSON.stringify(current)) {\n                                localStorage.setItem(TESTS_KEY, JSON.stringify(data.tests || []));\n                                hasChanges = true;\n                                console.log('\ud83d\udcdd Tests updated from cloud');\n                            }\n                        }\n\n                        if (data.target) {\n                            const current = JSON.parse(localStorage.getItem(TARGET_KEY)) || {};\n                            if (JSON.stringify(data.target) !== JSON.stringify(current)) {\n                                localStorage.setItem(TARGET_KEY, JSON.stringify(data.target));\n                                hasChanges = true;\n                                console.log('\ud83c\udfaf Target updated from cloud');\n                            }\n                        }\n\n                        if (data.tasks !== undefined && data.tasks !== null) {\n                            const current = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n                            if (JSON.stringify(data.tasks) !== JSON.stringify(current)) {\n                                localStorage.setItem(TASKS_KEY, JSON.stringify(data.tasks || []));\n                                hasChanges = true;\n                                console.log('\u2705 Tasks updated from cloud');\n                            }\n                        }\n\n                        if (hasChanges) {\n                            console.log('\ud83d\udd04 Refreshing all views due to real-time update');\n                            refreshAllViews();\n                            updateCloudStatus('online');\n                            showStickerToast('\ud83d\udd04 Synced with cloud!');\n                        }\n                    }, (error) => {\n                        console.warn('\u274c Realtime listener error:', error);\n                        updateCloudStatus('offline');\n                    });\n\n                console.log('\u2705 Realtime sync enabled!');\n            } catch (e) {\n                console.warn('\u26a0\ufe0f Failed to setup realtime sync:', e);\n            }\n        }\n\n        // \u2500\u2500\u2500 CLEAN UP REALTIME SYNC \u2500\u2500\u2500\n        function cleanupRealtimeSync() {\n            if (realtimeUnsubscribe) {\n                realtimeUnsubscribe();\n                realtimeUnsubscribe = null;\n                console.log('\ud83d\uded1 Realtime sync stopped');\n            }\n        }\n\n        async function fullSync() {\n            if (!currentUser || currentUser.isAnonymous || !isFirebaseReady) {\n                showStickerToast('\u26a0\ufe0f Please login with Google or Email to sync.');\n                return false;\n            }\n            if (syncInProgress) { showStickerToast('\u23f3 Sync already in progress...'); return false; }\n\n            const confirmed = await showPullConfirm();\n            if (!confirmed) {\n                showStickerToast('\u23f9\ufe0f Sync cancelled.');\n                return false;\n            }\n\n            updateCloudStatus('syncing');\n            const pulled = await pullFromCloud();\n            if (!pulled) {\n                const pushed = await syncAllToCloud();\n                if (pushed) { refreshAllViews(); return true; }\n                updateCloudStatus('offline');\n                showStickerToast('\u26a0\ufe0f Sync failed. Check your connection.');\n                return false;\n            }\n            refreshAllViews();\n            const pushed = await syncAllToCloud();\n            if (pushed) { refreshAllViews(); return true; }\n            return true;\n        }\n\n        // \u2500\u2500\u2500 DELETE TIMETABLE \u2500\u2500\u2500\n        async function deleteTimetable(dateStr) {\n            if (!dateStr) return false;\n            const confirmHtml = `\n                <p style=\"margin-bottom:8px;\">Are you sure you want to delete the timetable for <b style=\"color:var(--accent);\">${dateStr}</b>?</p>\n                <p style=\"color:var(--text-muted);font-size:0.75rem;\">This will also remove it from the cloud. This action cannot be undone.</p>\n            `;\n            const confirmed = await openStickerModal(\"Delete Timetable\", \"fas fa-trash-can\", confirmHtml);\n            if (!confirmed) return false;\n            let allData = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n            allData = allData.filter(d => d.date !== dateStr);\n            localStorage.setItem(TIMETABLE_KEY, JSON.stringify(allData));\n            if (currentUser && !currentUser.isAnonymous) await syncAllToCloud();\n            const histDate = document.getElementById('history-date-input').value;\n            if (histDate) loadHistory(histDate);\n            loadTodayView();\n            renderProDashboard();\n            renderCalendar();\n            showStickerToast(`\ud83d\uddd1\ufe0f Timetable for ${dateStr} deleted!`);\n            return true;\n        }\n\n        forceSyncBtn.addEventListener('click', async () => { await fullSync(); });\n\n        document.addEventListener('visibilitychange', () => {\n            if (!document.hidden && currentUser && !currentUser.isAnonymous) {\n                console.log('\ud83d\udcf1 App became visible \u2014 auto-pulling from cloud.');\n                pullFromCloud().then(() => refreshAllViews());\n            }\n        });\n\n        function refreshAllViews() {\n            loadTodayView();\n            renderCalendar();\n            updateLiveWidgets();\n            const histDate = document.getElementById('history-date-input').value;\n            if (histDate) loadHistory(histDate);\n            const studioDate = document.getElementById('studio-date-input').value;\n            if (studioDate) { loadStudioTimetable(studioDate);\n                renderStudioTasks(studioDate); }\n            renderTodayTasks();\n            renderAnalytics(currentFilter);\n            renderInsightsInside();\n        }\n\n        // \u2500\u2500\u2500 TABLE RENDER \u2500\u2500\u2500\n        function renderTable(obj, target) {\n            let html = `<div class=\"table-container\"><table><thead><tr>`;\n            obj.headers.forEach(h => html += `<th>${h}</th>`);\n            html += `</tr></thead><tbody>`;\n            obj.rows.forEach(r => {\n                html += `<tr>`;\n                r.forEach(c => html += `<td>${c}</td>`);\n                html += `</tr>`;\n            });\n            html += `</tbody></table></div>`;\n            target.innerHTML = html;\n        }\n\n        function loadTodayView() {\n            const container = document.getElementById('today-container');\n            const data = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n            const todayObj = data.find(d => d.date === todayStr);\n            if (!todayObj) {\n                container.innerHTML =\n                    `<div class=\"card\"><p>No custom timetable for today. Create one in <b>Studio</b>! \u2728</p></div>`;\n                return;\n            }\n            renderTable(todayObj, container);\n        }\n\n        // \u2500\u2500\u2500 Studio Timetable Load \u2500\u2500\u2500\n        function loadStudioTimetable(dateStr) {\n            const data = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n            const found = data.find(d => d.date === dateStr);\n            const headerRow = document.getElementById('matrix-header-row');\n            const bodyRows = document.getElementById('matrix-body-rows');\n            while (bodyRows.rows.length > 0) bodyRows.deleteRow(0);\n            if (!found) {\n                headerRow.innerHTML = `\n                    <th>Subject / Time</th>\n                    <th><input type=\"text\" value=\"08:00 AM\" /></th>\n                    <th><input type=\"text\" value=\"10:00 AM\" /></th>\n                    <th><input type=\"text\" value=\"12:00 PM\" /></th>\n                `;\n                const defaultRows = [\n                    ['Maths', 'Calculus', 'Algebra', 'Revision'],\n                    ['Physics', 'Mechanics', 'Optics', 'Numericals'],\n                    ['Chemistry', 'Organic', 'Inorganic', 'Equations']\n                ];\n                defaultRows.forEach(rowData => {\n                    const tr = document.createElement('tr');\n                    rowData.forEach(cellData => {\n                        const td = document.createElement('td');\n                        td.innerHTML = `<input type=\"text\" value=\"${cellData}\">`;\n                        tr.appendChild(td);\n                    });\n                    bodyRows.appendChild(tr);\n                });\n                return;\n            }\n            headerRow.innerHTML = '';\n            found.headers.forEach(h => {\n                const th = document.createElement('th');\n                th.innerHTML = `<input type=\"text\" value=\"${h}\">`;\n                headerRow.appendChild(th);\n            });\n            found.rows.forEach(rowData => {\n                const tr = document.createElement('tr');\n                rowData.forEach(cellData => {\n                    const td = document.createElement('td');\n                    td.innerHTML = `<input type=\"text\" value=\"${cellData}\">`;\n                    tr.appendChild(td);\n                });\n                bodyRows.appendChild(tr);\n            });\n        }\n\n        // \u2500\u2500\u2500 MATRIX CONTROLS \u2500\u2500\u2500\n        const headerRow = document.getElementById('matrix-header-row');\n        const bodyRows = document.getElementById('matrix-body-rows');\n\n        document.getElementById('add-time-col').addEventListener('click', async () => {\n            const total = headerRow.cells.length;\n            let opts = `<select id=\"modal-select-pos\">`;\n            for (let i = 1; i <= total; i++) opts += `<option value=\"${i}\">Before Col ${i}</option>`;\n            opts += `<option value=\"end\" selected>At the End</option></select>`;\n            opts += `<input type=\"text\" id=\"modal-input-val\" placeholder=\"Time Slot\" value=\"02:00 PM\">`;\n            const res = await openStickerModal(\"Add Time Column\", \"fas fa-clock\", opts);\n            if (!res) return;\n            const pos = document.getElementById('modal-select-pos').value;\n            const val = document.getElementById('modal-input-val').value;\n            if (!val) return;\n            const idx = pos === 'end' ? total : parseInt(pos) - 1;\n            const th = document.createElement('th');\n            th.innerHTML = `<input type=\"text\" value=\"${val}\">`;\n            if (idx >= total) headerRow.appendChild(th);\n            else headerRow.insertBefore(th, headerRow.cells[idx]);\n            Array.from(bodyRows.rows).forEach(row => {\n                const td = document.createElement('td');\n                td.innerHTML = `<input type=\"text\" placeholder=\"Task\">`;\n                if (idx >= row.cells.length) row.appendChild(td);\n                else row.insertBefore(td, row.cells[idx]);\n            });\n            showStickerToast(\"\u2728 Time column added!\");\n        });\n\n        document.getElementById('remove-time-col').addEventListener('click', async () => {\n            const total = headerRow.cells.length - 1;\n            if (total <= 1) { showStickerToast(\"\u26a0\ufe0f Minimum 1 time slot!\"); return; }\n            let opts = `<select id=\"modal-select-pos\">`;\n            for (let i = 1; i <= total; i++) {\n                const label = headerRow.cells[i].querySelector('input')?.value || `Col ${i}`;\n                opts += `<option value=\"${i}\">${i}: ${label}</option>`;\n            }\n            opts += `</select>`;\n            const res = await openStickerModal(\"Remove Time Column\", \"fas fa-trash-can\", opts);\n            if (!res) return;\n            const idx = parseInt(document.getElementById('modal-select-pos').value);\n            headerRow.deleteCell(idx);\n            Array.from(bodyRows.rows).forEach(row => row.deleteCell(idx));\n            showStickerToast(\"\ud83d\uddd1\ufe0f Column removed.\");\n        });\n\n        document.getElementById('add-subject-row').addEventListener('click', async () => {\n            const total = bodyRows.rows.length;\n            let opts = `<select id=\"modal-select-pos\">`;\n            for (let i = 1; i <= total; i++) opts += `<option value=\"${i-1}\">Before Row ${i}</option>`;\n            opts += `<option value=\"end\" selected>At the End</option></select>`;\n            opts += `<input type=\"text\" id=\"modal-input-val\" placeholder=\"Subject\" value=\"Biology\">`;\n            const res = await openStickerModal(\"Add Subject Row\", \"fas fa-book-open\", opts);\n            if (!res) return;\n            const pos = document.getElementById('modal-select-pos').value;\n            const sub = document.getElementById('modal-input-val').value;\n            if (!sub) return;\n            const idx = pos === 'end' ? total : parseInt(pos);\n            const colCount = headerRow.cells.length;\n            const row = document.createElement('tr');\n            for (let i = 0; i < colCount; i++) {\n                const td = document.createElement('td');\n                td.innerHTML = i === 0 ? `<input type=\"text\" value=\"${sub}\">` : `<input type=\"text\" placeholder=\"Task\">`;\n                row.appendChild(td);\n            }\n            if (idx >= total) bodyRows.appendChild(row);\n            else bodyRows.insertBefore(row, bodyRows.rows[idx]);\n            showStickerToast(\"\u2728 Subject row added!\");\n        });\n\n        document.getElementById('remove-subject-row').addEventListener('click', async () => {\n            const total = bodyRows.rows.length;\n            if (total <= 1) { showStickerToast(\"\u26a0\ufe0f Minimum 1 subject row!\"); return; }\n            let opts = `<select id=\"modal-select-pos\">`;\n            for (let i = 0; i < total; i++) {\n                const label = bodyRows.rows[i].cells[0].querySelector('input')?.value || `Row ${i+1}`;\n                opts += `<option value=\"${i}\">${i+1}: ${label}</option>`;\n            }\n            opts += `</select>`;\n            const res = await openStickerModal(\"Remove Subject Row\", \"fas fa-trash-can\", opts);\n            if (!res) return;\n            const idx = parseInt(document.getElementById('modal-select-pos').value);\n            bodyRows.deleteRow(idx);\n            showStickerToast(\"\ud83d\uddd1\ufe0f Subject row removed.\");\n        });\n\n        // \u2500\u2500\u2500 STUDIO DATE LOAD \u2500\u2500\u2500\n        document.getElementById('load-studio-date-btn').addEventListener('click', () => {\n            const dateVal = document.getElementById('studio-date-input').value;\n            if (dateVal) {\n                loadStudioTimetable(dateVal);\n                renderStudioTasks(dateVal);\n                showStickerToast(`\ud83d\udcc5 Loaded timetable for ${dateVal}`);\n            } else showStickerToast('\u26a0\ufe0f Please select a date.');\n        });\n\n        document.getElementById('studio-today-btn').addEventListener('click', () => {\n            document.getElementById('studio-date-input').value = todayStr;\n            loadStudioTimetable(todayStr);\n            renderStudioTasks(todayStr);\n            showStickerToast(`\ud83d\udcc5 Loaded today's timetable`);\n        });\n\n        // \u2500\u2500\u2500 SAVE & SYNC \u2500\u2500\u2500\n        document.getElementById('save-timetable-btn').addEventListener('click', async () => {\n            const dateVal = document.getElementById('studio-date-input').value;\n            if (!dateVal) { showStickerToast('\u26a0\ufe0f Please select a date first.'); return; }\n            const headers = Array.from(headerRow.cells).map(th => th.querySelector('input')?.value || th.innerText);\n            const rows = Array.from(bodyRows.rows).map(row => Array.from(row.cells).map(cell => cell.querySelector(\n                'input')?.value || cell.innerText));\n            if (headers.length < 2) { showStickerToast('\u26a0\ufe0f Need at least 1 time column.'); return; }\n            if (rows.length < 1) { showStickerToast('\u26a0\ufe0f Need at least 1 subject row.'); return; }\n            const payload = { date: dateVal, headers, rows };\n            let allData = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n            allData = allData.filter(d => d.date !== dateVal);\n            allData.push(payload);\n            localStorage.setItem(TIMETABLE_KEY, JSON.stringify(allData));\n            showStickerToast(`\ud83c\udf89 Timetable saved for ${dateVal}!`);\n            if (dateVal === todayStr) loadTodayView();\n            renderCalendar();\n            if (currentUser && !currentUser.isAnonymous) {\n                let success = false,\n                    attempts = 0;\n                while (!success && attempts < 3) {\n                    attempts++;\n                    success = await syncAllToCloud();\n                    if (!success && attempts < 3) await new Promise(r => setTimeout(r, 1000));\n                }\n                if (!success) showStickerToast(\"\u26a0\ufe0f Saved locally but cloud push failed. Use 'Push to Cloud' button.\");\n            } else showStickerToast(\"\ud83d\udcbe Timetable saved locally (guest mode).\");\n        });\n\n        // \u2500\u2500\u2500 CALENDAR \u2500\u2500\u2500\n        let currMonth = new Date().getMonth();\n        let currYear = new Date().getFullYear();\n\n        function renderCalendar() {\n            const months = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\",\n                \"November\", \"December\"\n            ];\n            document.getElementById('calendar-month-year').innerText = `${months[currMonth]} ${currYear}`;\n            const grid = document.getElementById('calendar-dates-grid');\n            grid.innerHTML = '';\n            const firstDay = new Date(currYear, currMonth, 1).getDay();\n            const totalDays = new Date(currYear, currMonth + 1, 0).getDate();\n            const savedTests = (JSON.parse(localStorage.getItem(TESTS_KEY)) || []).map(t => t.date);\n            const tasksData = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n            const taskDates = tasksData.map(t => t.date);\n            const timetables = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n            const ttDates = timetables.map(t => t.date);\n\n            for (let i = 0; i < firstDay; i++) grid.appendChild(document.createElement('div'));\n            for (let day = 1; day <= totalDays; day++) {\n                const cell = document.createElement('div');\n                cell.className = 'calendar-date';\n                cell.innerText = day;\n                const mStr = String(currMonth + 1).padStart(2, '0');\n                const dStr = String(day).padStart(2, '0');\n                const key = `${currYear}-${mStr}-${dStr}`;\n                if (globalFestivals[key]) cell.classList.add('has-festival');\n                if (savedTests.includes(key)) cell.classList.add('has-test');\n                if (taskDates.includes(key)) cell.classList.add('has-tasks');\n                if (ttDates.includes(key)) cell.classList.add('has-timetable');\n                if (key === todayStr) cell.classList.add('selected');\n                cell.addEventListener('click', () => {\n                    document.querySelectorAll('.calendar-date').forEach(d => d.classList.remove('selected'));\n                    cell.classList.add('selected');\n                    inspectDate(key);\n                });\n                grid.appendChild(cell);\n            }\n            inspectDate(todayStr);\n        }\n\n        document.getElementById('prev-month').addEventListener('click', () => { currMonth--;\n\n            if (currMonth < 0) { currMonth = 11;\n                currYear--; }\n            renderCalendar(); });\n        document.getElementById('next-month').addEventListener('click', () => { currMonth++;\n\n            if (currMonth > 11) { currMonth = 0;\n                currYear++; }\n            renderCalendar(); });\n\n        function inspectDate(dateStr) {\n            const container = document.getElementById('calendar-selected-data');\n            const timetables = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n            const tests = JSON.parse(localStorage.getItem(TESTS_KEY)) || [];\n            const tMatch = timetables.find(d => d.date === dateStr);\n            const testMatch = tests.find(t => t.date === dateStr);\n            const festMatch = globalFestivals[dateStr];\n            let html = `<h3 style=\"font-size:0.85rem;\">\ud83d\udcc5 ${dateStr}</h3>`;\n            if (festMatch) {\n                html += `<div class=\"card\" style=\"border-color:var(--festival-color);background:rgba(114,9,183,0.06);\">\n                    <p style=\"color:var(--festival-color);\"><b>\ud83c\udf89 Festival:</b> ${festMatch}</p></div>`;\n            }\n            if (testMatch) {\n                html += `<div class=\"card\" style=\"border-color:var(--accent);background:rgba(230,57,70,0.06);\">\n                    <p style=\"color:var(--accent);\"><b>\ud83d\udcdd Event:</b> ${testMatch.subject}</p>\n                    <button class=\"btn danger\" style=\"margin-top:4px;padding:3px 8px;font-size:0.65rem;\" onclick=\"removeTest('${dateStr}')\">Remove</button>\n                </div>`;\n            } else {\n                html +=\n                    `<button class=\"btn primary\" style=\"width:100%;margin-bottom:6px;padding:5px;\" onclick=\"promptAddTest('${dateStr}')\"><i class=\"fas fa-plus\"></i> Add Event</button>`;\n            }\n            if (tMatch) { html += `<div id=\"cal-table-box\"></div>`; } else {\n                html += `<p style=\"color:var(--text-muted);font-size:0.7rem;\">No timetable for this date.</p>`;\n            }\n\n            const tasksData = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n            const dateTasks = tasksData.find(t => t.date === dateStr);\n            if (dateTasks && dateTasks.tasks && dateTasks.tasks.length > 0) {\n                const tasks = dateTasks.tasks;\n                const completed = tasks.filter(t => t.completed).length;\n                const total = tasks.length;\n                const sortedTasks = [...tasks];\n                html += `<div class=\"calendar-tasks-section\">\n                    <h4><i class=\"fas fa-list-check\"></i> Tasks for this day</h4>\n                    <div class=\"task-progress-wrap\" style=\"margin-bottom:4px;\">\n                        <span style=\"font-size:0.65rem;font-weight:600;\">${completed}/${total}</span>\n                        <div class=\"task-progress-bar\"><div class=\"fill\" style=\"width:${total > 0 ? Math.round((completed/total)*100) : 0}%;\"></div></div>\n                        <span class=\"task-progress-text\">${total > 0 ? Math.round((completed/total)*100) : 0}%</span>\n                    </div>\n                    <ul class=\"task-list\">\n                `;\n                sortedTasks.forEach(t => {\n                    html += `\n                        <li class=\"task-item ${t.completed ? 'completed' : ''}\">\n                            <span class=\"task-check ${t.completed ? 'checked' : ''}\" style=\"pointer-events:none;width:18px;height:18px;font-size:0.5rem;\">\n                                <i class=\"fas ${t.completed ? 'fa-circle-check' : 'fa-circle'}\"></i>\n                            </span>\n                            <span class=\"task-text\" style=\"font-size:0.7rem;\">${t.text}</span>\n                        </li>\n                    `;\n                });\n                html += `</ul></div>`;\n            }\n\n            container.innerHTML = html;\n            if (tMatch) renderTable(tMatch, document.getElementById('cal-table-box'));\n        }\n\n        window.promptAddTest = async function(dateStr) {\n            const html = `<input type=\"text\" id=\"modal-test-input\" placeholder=\"Event / Test Name\" value=\"Quiz\">`;\n            const res = await openStickerModal(\"Schedule Event\", \"fas fa-bookmark\", html);\n            if (!res) return;\n            const subject = document.getElementById('modal-test-input').value;\n            if (!subject) return;\n            let tests = JSON.parse(localStorage.getItem(TESTS_KEY)) || [];\n            tests = tests.filter(t => t.date !== dateStr);\n            tests.push({ date: dateStr, subject });\n            localStorage.setItem(TESTS_KEY, JSON.stringify(tests));\n            showStickerToast(\"\ud83d\udcdd Event scheduled!\");\n            renderCalendar();\n            inspectDate(dateStr);\n            if (currentUser && !currentUser.isAnonymous) await syncAllToCloud();\n        };\n\n        window.removeTest = function(dateStr) {\n            let tests = JSON.parse(localStorage.getItem(TESTS_KEY)) || [];\n            tests = tests.filter(t => t.date !== dateStr);\n            localStorage.setItem(TESTS_KEY, JSON.stringify(tests));\n            showStickerToast(\"Event deleted.\");\n            renderCalendar();\n            inspectDate(dateStr);\n            if (currentUser && !currentUser.isAnonymous) syncAllToCloud();\n        };\n\n        // \u2500\u2500\u2500 TASKS FUNCTIONS \u2500\u2500\u2500\n        function getTasksForDate(dateStr) {\n            const all = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n            const found = all.find(d => d.date === dateStr);\n            return found ? found.tasks : [];\n        }\n\n        function saveTasksForDate(dateStr, tasks) {\n            let all = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n            all = all.filter(d => d.date !== dateStr);\n            if (tasks && tasks.length > 0) all.push({ date: dateStr, tasks: tasks });\n            localStorage.setItem(TASKS_KEY, JSON.stringify(all));\n        }\n\n        function checkAndCelebrateAllDone(dateStr) {\n            const tasks = getTasksForDate(dateStr);\n            if (tasks.length === 0) return;\n            const allDone = tasks.every(t => t.completed);\n            if (allDone) showStickerToast(\"\ud83c\udf89 Yay! All tasks complete! \ud83c\udf89\", \"\ud83c\udf89\");\n        }\n\n        // \u2500\u2500\u2500 RENDER TASKS HELPER \u2500\u2500\u2500\n        function renderTaskList(container, dateStr, isStudio = false) {\n            const tasks = getTasksForDate(dateStr);\n            const today = new Date();\n            const todayStrLocal = getLocalDate(today);\n            const isFuture = dateStr > todayStrLocal;\n            const isToday = dateStr === todayStrLocal;\n\n            let html = `<div class=\"future-date-label\">\ud83d\udcc6 ${isToday ? 'Today' : isFuture ? 'Future' : 'Past'}</div>`;\n\n            // Only show add button for studio tasks (future tasks)\n            if (isStudio) {\n                html += `\n                    <div class=\"task-add-row\">\n                        <input type=\"text\" id=\"studio-task-input-field\" placeholder=\"Add a task...\" maxlength=\"200\" />\n                        <button class=\"btn primary\" id=\"studio-task-add-btn\"><i class=\"fas fa-plus\"></i> Add</button>\n                    </div>\n                `;\n            } else {\n                html += `\n                    <div class=\"task-add-row\">\n                        <input type=\"text\" id=\"task-input-field\" placeholder=\"Add a task...\" maxlength=\"200\" />\n                        <button class=\"btn primary\" id=\"task-add-btn\"><i class=\"fas fa-plus\"></i> Add</button>\n                    </div>\n                `;\n            }\n\n            if (tasks.length === 0) {\n                html += `<div class=\"no-tasks-msg\">No tasks for this date. Add one above.</div>`;\n            } else {\n                const completed = tasks.filter(t => t.completed).length;\n                const total = tasks.length;\n                const pct = total > 0 ? Math.round((completed / total) * 100) : 0;\n                // Keep tasks in original order - no sorting\n                html += `\n                    <div class=\"task-progress-wrap\">\n                        <span style=\"font-size:0.65rem;font-weight:600;\">${completed}/${total}</span>\n                        <div class=\"task-progress-bar\"><div class=\"fill\" style=\"width:${pct}%;\"></div></div>\n                        <span class=\"task-progress-text\">${pct}%</span>\n                    </div>\n                    <ul class=\"task-list\" id=\"${isStudio ? 'studio-task-list' : 'today-task-list'}\">\n                `;\n                tasks.forEach((t, idx) => {\n                    const checked = t.completed ? 'checked' : '';\n                    const icon = t.completed ? 'fa-circle-check' : 'fa-circle';\n                    // For studio, hide the check button\n                    const checkHtml = isStudio ? '' :\n                        `<span class=\"task-check ${checked}\" data-idx=\"${idx}\" title=\"Toggle complete\"><i class=\"fas ${icon}\"></i></span>`;\n                    html += `\n                        <li class=\"task-item ${t.completed ? 'completed' : ''}\" data-idx=\"${idx}\" data-task-id=\"${t.id || idx}\">\n                            ${checkHtml}\n                            <span class=\"task-text\">${t.text}</span>\n                            <button class=\"task-delete-btn\" data-idx=\"${idx}\" title=\"Delete task\"><i class=\"fas fa-times\"></i></button>\n                        </li>\n                    `;\n                });\n                html += `</ul>`;\n            }\n            container.innerHTML = html;\n\n            // Add event listeners only for Today tab (non-studio