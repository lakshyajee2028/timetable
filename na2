<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111827">
<title>Signature Edition Royale | Study Command Centre</title>
<style>
:root{--ink:#111827;--gold:#d6b36a;--gold2:#f5df9a;--panel:#171c2b;--muted:#aab2c5;}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:#0b1020;color:#f8fafc}
.shell{height:100%;display:flex;flex-direction:column;background:radial-gradient(circle at 12% 0%,rgba(214,179,106,.12),transparent 28%),#0b1020}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 18px;background:linear-gradient(110deg,#111827,#1a2030 55%,#111827);border-bottom:1px solid rgba(214,179,106,.38);box-shadow:0 8px 28px #0004;z-index:5;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:11px;min-width:0}
.crest{width:42px;height:42px;border:1px solid var(--gold);border-radius:13px;display:grid;place-items:center;color:var(--gold2);font-size:20px;background:linear-gradient(145deg,#272d3b,#101522);box-shadow:inset 0 0 0 3px #d6b36a14}
.brand h1{font-size:clamp(14px,2vw,19px);margin:0;letter-spacing:.07em;font-weight:900}
.brand p{font-size:10px;letter-spacing:.19em;text-transform:uppercase;color:var(--gold);margin:4px 0 0}
.nav{display:flex;gap:8px;flex-wrap:wrap}
.nav button{border:1px solid #ffffff20;color:#d7dbea;background:#ffffff08;border-radius:12px;padding:10px 14px;font-weight:800;cursor:pointer;transition:.2s;font-size:12px}
.nav button:hover{border-color:#d6b36a88;color:#fff}
.nav button.active{background:linear-gradient(135deg,#f3d78f,#c49a4a);color:#171717;border-color:#f3d78f;box-shadow:0 5px 18px #d6b36a26}
.content{position:relative;flex:1;min-height:0;background:#f8fafc}
.app-frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#f8fafc;display:none}
.app-frame.active{display:block}
@media(max-width:600px){.topbar{padding:9px 10px;gap:9px}.crest{width:35px;height:35px}.brand p{font-size:8px;letter-spacing:.12em}.nav{width:100%;display:grid;grid-template-columns:1fr 1fr}.nav button{padding:10px 8px}}
</style>
</head>
