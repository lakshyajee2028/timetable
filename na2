>\n            <div class=\"particle p6\"></div>\n        </div>\n        <div class=\"decor decor1\"></div>\n        <div class=\"decor decor2\"></div>\n        <div class=\"decor decor3\"></div>\n        <div class=\"decor decor4\"></div>\n        <div class=\"scene\">\n            <div class=\"floor-shadow\"></div>\n            <div class=\"book\">\n                <div class=\"book-cover\"></div>\n                <div class=\"pages\">\n                    <div class=\"page-left\">\n                        <div class=\"paper-lines\"></div>\n                        <div class=\"small-doodle doodle1\"></div>\n                    </div>\n                    <div class=\"page-right\">\n                        <div class=\"paper-lines\"></div>\n                        <div class=\"small-doodle doodle2\"></div>\n                    </div>\n                    <div class=\"binding\"></div>\n                </div>\n                <div class=\"flip flip1\"></div>\n                <div class=\"flip flip2\"></div>\n                <div class=\"flip flip3\"></div>\n            </div>\n            <div class=\"character\">\n                <div class=\"eyes\">\n                    <div class=\"eye\"></div>\n                    <div class=\"eye\"></div>\n                </div>\n                <div class=\"mouth\"></div>\n            </div>\n            <div class=\"title\">Time Table</div>\n            <div class=\"subtitle\">PLAN \u2022 STUDY \u2022 ACHIEVE</div>\n        </div>\n    </div>\n\n    <!-- Rest of the app -->\n    <div class=\"bg-decor\">\n        <div class=\"floating-item\">\ud83d\udcda</div>\n        <div class=\"floating-item\">\u270f\ufe0f</div>\n        <div class=\"floating-item\">\ud83d\udd8d\ufe0f</div>\n        <div class=\"floating-item\">\ud83d\udcd6</div>\n        <div class=\"floating-item\">\ud83d\udd8a\ufe0f</div>\n        <div class=\"floating-item\">\ud83c\udfa8</div>\n        <div class=\"floating-item\">\u2b50</div>\n    </div>\n\n    <div id=\"sticker-toast\">\n        <i class=\"fas fa-sparkles\"></i>\n        <span id=\"toast-text\">Ready!</span>\n    </div>\n\n    <!-- Undo Confirmation Modal -->\n    <div class=\"undo-confirm-modal\" id=\"undo-confirm-modal\">\n        <div class=\"undo-confirm-box\">\n            <h3><i class=\"fas fa-rotate-left\"></i> Undo Task</h3>\n            <p id=\"undo-task-text\">Are you sure you want to mark this task as incomplete?</p>\n            <div class=\"undo-actions\">\n                <button class=\"btn btn-cancel\" id=\"undo-confirm-cancel\">Cancel</button>\n                <button class=\"btn btn-undo\" id=\"undo-confirm-yes\">Yes, Undo</button>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"modal-overlay\" id=\"custom-modal\">\n        <div class=\"modal-box\">\n            <h3 id=\"modal-title\"><i class=\"fas fa-pencil-alt\"></i> Sticker Note</h3>\n            <div id=\"modal-content-area\"></div>\n            <div class=\"modal-actions\">\n                <button class=\"btn\" id=\"modal-cancel-btn\">Cancel</button>\n                <button class=\"btn primary\" id=\"modal-confirm-btn\">Confirm</button>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"confirm-modal-overlay\" id=\"pull-confirm-modal\">\n        <div class=\"confirm-modal-box\">\n            <h3><i class=\"fas fa-cloud-upload-alt\"></i> Sync Data</h3>\n            <p>Do you want to pull the latest data from the cloud? Your local changes will be merged.</p>\n            <div class=\"confirm-actions\">\n                <button class=\"btn btn-cancel\" id=\"pull-confirm-cancel\">Cancel</button>\n                <button class=\"btn btn-confirm\" id=\"pull-confirm-yes\">Yes, Pull</button>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"app-container\" id=\"appContainer\">\n\n        <div id=\"login-overlay\">\n            <div class=\"login-icon\"><i class=\"fas fa-user-graduate\"></i></div>\n            <h2>Study Time-Table</h2>\n            <p>Sign in to sync your timetable across devices.</p>\n            <div class=\"login-loader show\" id=\"login-loader\" style=\"display: flex; flex-direction: column; gap: 8px;\">\n                <i class=\"fas fa-circle-notch fa-spin\" style=\"font-size: 1.5rem; color: var(--primary);\"></i>\n                <p style=\"margin: 0; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); max-width: 250px;\">\n                    If you have already logged in, please wait for a few seconds...\n                </p>\n            </div>\n\n            <div class=\"login-methods\">\n                <button class=\"btn-google\" id=\"google-login-btn\">\n                    <i class=\"fab fa-google\"></i> Sign in with Google\n                </button>\n                <div class=\"method-divider\">or</div>\n                <div class=\"input-group\">\n                    <input type=\"email\" id=\"email-input\" placeholder=\"Email address\" />\n                    <input type=\"password\" id=\"password-input\" placeholder=\"Password\" />\n                    <div class=\"email-actions\">\n                        <button class=\"btn-action primary\" id=\"email-signin-btn\">Sign In</button>\n                        <button class=\"btn-action\" id=\"email-signup-btn\">Sign Up</button>\n                    </div>\n                    <div class=\"forgot-link\" id=\"forgot-password-link\">Forgot password?</div>\n                </div>\n                <div class=\"method-divider\">or</div>\n                <button class=\"btn-guest\" id=\"guest-login-btn\">\n                    <i class=\"fas fa-user-astronaut\"></i> Continue as Guest\n                </button>\n            </div>\n            <div style=\"margin-top:10px; font-size:0.55rem; color:var(--text-muted); opacity:0.7;\">\n                <i class=\"fas fa-lock\"></i> Guest data stays on this device only.\n            </div>\n        </div>\n\n        <header>\n            <div class=\"logo-area\">\n                <div class=\"mascot-avatar\"><i class=\"fas fa-cat\"></i></div>\n                <h1 id=\"app-title\">SELF STUDY T-T</h1>\n            </div>\n            <div class=\"header-controls\">\n                <div class=\"user-badge\" id=\"user-badge\" style=\"display:none;\" title=\"Click to sign out\">\n                    <img id=\"user-avatar\" src=\"\" alt=\"avatar\" />\n                    <span class=\"user-name\" id=\"user-name-display\">User</span>\n                    <span id=\"user-type-badge\" class=\"guest-badge\" style=\"display:none;\">Guest</span>\n                    <span class=\"logout-tip\"><i class=\"fas fa-sign-out-alt\"></i></span>\n                </div>\n                <button class=\"icon-btn\" id=\"theme-toggle\" title=\"Toggle Theme\"><i class=\"fas fa-moon\" id=\"theme-icon\"></i></button>\n            </div>\n        </header>\n\n        <main>\n            <div id=\"view-dashboard\" class=\"view-section active\">\n                <div class=\"dash-welcome-row\">\n                    <div><div class=\"dash-eyebrow signature-wordmark\"><span class=\"signature-crown\">\u265b</span><span>Signature Edition</span><span class=\"signature-rule\"></span></div><h2><i class=\"fas fa-layer-group\"></i> Dashboard</h2><p id=\"dash-date-line\">Your day, clearly planned.</p></div>\n                    <div class=\"dash-live-pill\"><span class=\"dash-live-dot\"></span> LIVE OVERVIEW</div>\n                </div>\n                <div class=\"dash-hero\">\n                    <div class=\"dash-hero-copy\"><span class=\"dash-kicker\">MAKE TODAY COUNT</span><h3>One focused step at a time.</h3><p>Keep your timetable, tasks and progress in one calm, organised space.</p><button class=\"dash-primary-btn\" type=\"button\" data-go-view=\"view-today\"><i class=\"fas fa-arrow-right\"></i> Open Today</button></div>\n                    <div class=\"dash-hero-art\" aria-hidden=\"true\"><div class=\"dash-orbit orbit-one\"></div><div class=\"dash-orbit orbit-two\"></div><div class=\"dash-hero-icon\"><i class=\"fas fa-bullseye\"></i></div><span class=\"dash-spark spark-one\">\u2726</span><span class=\"dash-spark spark-two\">\u2727</span></div>\n                </div>\n                <div class=\"dash-metrics-grid\">\n                    <div class=\"dash-metric metric-violet\"><div class=\"dash-metric-top\"><span>Today's tasks</span><i class=\"fas fa-list-check\"></i></div><strong id=\"dash-task-total\">0</strong><div class=\"dash-metric-foot\"><span id=\"dash-task-done\">0 completed</span><span class=\"dash-mini-track\"><i id=\"dash-task-fill\"></i></span></div></div>\n                    <div class=\"dash-metric metric-teal\"><div class=\"dash-metric-top\"><span>Timetable</span><i class=\"fas fa-calendar-day\"></i></div><strong id=\"dash-schedule-status\">Ready</strong><div class=\"dash-metric-foot\" id=\"dash-schedule-note\">Today's plan at a glance</div></div>\n                    <div class=\"dash-metric metric-amber\"><div class=\"dash-metric-top\"><span>Upcoming tests</span><i class=\"fas fa-book-open\"></i></div><strong id=\"dash-test-count\">0</strong><div class=\"dash-metric-foot dash-upcoming-test-foot\"><div id=\"dash-upcoming-test-slide\" class=\"dash-upcoming-test-slide\" aria-live=\"polite\"><span class=\"dash-test-slide-name\">No upcoming tests</span><small>Add a reminder below</small></div></div></div>\n                    <div class=\"dash-metric metric-blue\"><div class=\"dash-metric-top\"><span>Current time</span><i class=\"fas fa-clock\"></i></div><strong id=\"dash-clock\">--:--</strong><div class=\"dash-metric-foot\" id=\"dash-clock-date\">Stay in your rhythm</div></div>\n                </div>\n                <div class=\"dash-lower-grid\">\n                    <section class=\"dash-panel dash-tasks-panel\"><div class=\"dash-panel-head\"><div><span class=\"dash-section-label\">FOCUS LIST</span><h3>Today's priorities</h3></div><button class=\"dash-text-btn\" type=\"button\" data-go-view=\"view-today\">View tasks <i class=\"fas fa-arrow-up-right-from-square\"></i></button></div><div id=\"dash-task-preview\" class=\"dash-task-preview\"></div></section>\n                    <section class=\"dash-panel dash-shortcuts-panel\"><div class=\"dash-panel-head\"><div><span class=\"dash-section-label\">QUICK ACCESS</span><h3>Your workspace</h3></div></div><div class=\"dash-shortcuts\"><button type=\"button\" data-go-view=\"view-today\"><span class=\"shortcut-icon shortcut-violet\"><i class=\"fas fa-sun\"></i></span><span><b>Today</b><small>Schedule & task list</small></span><i class=\"fas fa-chevron-right shortcut-arrow\"></i></button><button type=\"button\" data-go-view=\"view-create\"><span class=\"shortcut-icon shortcut-teal\"><i class=\"fas fa-pen-ruler\"></i></span><span><b>Timetable Studio</b><small>Plan your study day</small></span><i class=\"fas fa-chevron-right shortcut-arrow\"></i></button><button type=\"button\" data-go-view=\"view-calendar\"><span class=\"shortcut-icon shortcut-amber\"><i class=\"fas fa-calendar-days\"></i></span><span><b>Calendar</b><small>Review dates & plans</small></span><i class=\"fas fa-chevron-right shortcut-arrow\"></i></button><button type=\"button\" data-go-view=\"view-analytics\"><span class=\"shortcut-icon shortcut-blue\"><i class=\"fas fa-chart-line\"></i></span><span><b>Analytics</b><small>Track your progress</small></span><i class=\"fas fa-chevron-right shortcut-arrow\"></i></button></div></section>\n                </div>\n                <section class=\"signature-reminders-panel\" aria-labelledby=\"test-reminders-heading\">\n                    <div class=\"signature-reminders-head\">\n                        <div><span class=\"dash-section-label\">PLAN AHEAD</span><h3 id=\"test-reminders-heading\"><i class=\"fas fa-book-open\"></i> Test Reminders</h3><p>Keep upcoming tests and quizzes in one place.</p></div>\n                        <span class=\"reminder-count-badge\" id=\"reminder-list-count\">0 upcoming</span>\n                    </div>\n                    <form id=\"test-reminder-form\" class=\"test-reminder-form\">\n                        <label class=\"reminder-field\"><span>Test / exam name</span><input id=\"test-reminder-name\" type=\"text\" maxlength=\"90\" placeholder=\"e.g. Physics: NLM test\" required /></label>\n                        <label class=\"reminder-field\"><span>Test date</span><input id=\"test-reminder-date\" type=\"date\" required /></label>\n                        <button class=\"reminder-add-btn\" type=\"submit\"><i class=\"fas fa-plus\"></i> Add reminder</button>\n                    </form>\n                    <div id=\"test-reminder-list\" class=\"test-reminder-list\" aria-live=\"polite\"><div class=\"reminder-empty\"><i class=\"fas fa-calendar-check\"></i><span>No test reminders yet. Add your next test above.</span></div></div>\n                </section>\n                <div class=\"royal-signature-block\" aria-label=\"Website signature\"><span>crafted with focus</span><strong>Priyanshu Singh</strong><small>SIGNATURE EDITION</small></div>\n            </div>\n\n            <div id=\"view-today\" class=\"view-section\">\n                <div class=\"home-widgets-grid\">\n                    <div class=\"widget-box\">\n                        <div class=\"widget-title\"><i class=\"fas fa-clock\"></i> Live Time</div>\n                        <div class=\"widget-value\" id=\"live-clock-display\">00:00:00</div>\n                        <div class=\"countdown-sub\" id=\"live-date-display\">--</div>\n                    </div>\n                    <div class=\"widget-box\" id=\"target-widget-box\" style=\"cursor: pointer;\" title=\"Tap to change target date\">\n                        <div class=\"widget-title\"><i class=\"fas fa-bullseye\"></i> <span id=\"target-name-label\">Target</span></div>\n                        <div class=\"widget-value\" id=\"target-countdown-display\" style=\"font-size:0.75rem;\">0d 0h 0m 0s</div>\n                        <div class=\"countdown-sub\">Tap to set \ud83c\udfaf</div>\n                    </div>\n                </div>\n                <h2 id=\"today-heading\"><i class=\"fas fa-sun\"></i> Today's Schedule</h2>\n                <div id=\"today-container\"></div>\n\n                <div class=\"tasks-section\" id=\"today-tasks-section\">\n                    <h3><i class=\"fas fa-list-check\"></i> Today's Tasks</h3>\n                    <div id=\"today-tasks-container\"></div>\n                </div>\n            </div>\n\n            <div id=\"view-yesterday\" class=\"view-section\">\n                <h2><i class=\"fas fa-box-archive\"></i> All Past Time-Tables</h2>\n                <div class=\"search-box\">\n                    <input type=\"date\" id=\"history-date-input\" />\n                    <button class=\"btn primary\" id=\"search-history-btn\" style=\"width:auto; padding:4px 10px;\">Find</button>\n                </div>\n                <div id=\"history-container\"></div>\n                <div id=\"history-delete-area\"></div>\n                <div class=\"long-press-hint\"><i class=\"fas fa-hand-pointer\"></i> Long press on timetable to delete</div>\n                <div class=\"history-tasks-section\" id=\"history-tasks-section\" style=\"display:none;\">\n                    <h4><i class=\"fas fa-list-check\"></i> Tasks for this day</h4>\n                    <div id=\"history-tasks-container\"></div>\n                </div>\n            </div>\n\n            <div id=\"view-create\" class=\"view-section\">\n                <h2><i class=\"fas fa-wand-magic-sparkles\"></i> Timetable Studio</h2>\n                <div class=\"studio-date-selector\">\n                    <input type=\"date\" id=\"studio-date-input\" />\n                    <button class=\"btn primary\" id=\"load-studio-date-btn\"><i class=\"fas fa-calendar-day\"></i> Load</button>\n                    <button class=\"btn success\" id=\"studio-today-btn\"><i class=\"fas fa-sun\"></i> Today</button>\n                </div>\n                <div class=\"btn-grid\">\n                    <button class=\"btn\" id=\"add-subject-row\"><i class=\"fas fa-plus-circle\"></i> Add Row</button>\n                    <button class=\"btn\" id=\"add-time-col\"><i class=\"fas fa-plus-circle\"></i> Add Col</button>\n                    <button class=\"btn danger\" id=\"remove-subject-row\"><i class=\"fas fa-trash-can\"></i> Del Row</button>\n                    <button class=\"btn danger\" id=\"remove-time-col\"><i class=\"fas fa-trash-can\"></i> Del Col</button>\n                </div>\n                <div class=\"table-container\">\n                    <table id=\"matrix-table\">\n                        <thead><tr id=\"matrix-header-row\">\n                            <th>Subject / Time</th>\n                            <th><input type=\"text\" value=\"08:00 AM\" /></th>\n                            <th><input type=\"text\" value=\"10:00 AM\" /></th>\n                            <th><input type=\"text\" value=\"12:00 PM\" /></th>\n                        </tr></thead>\n                        <tbody id=\"matrix-body-rows\">\n                            <tr><td><input type=\"text\" value=\"Maths\" /></td><td><input type=\"text\" value=\"Calculus\" /></td><td><input type=\"text\" value=\"Algebra\" /></td><td><input type=\"text\" value=\"Revision\" /></td></tr>\n                            <tr><td><input type=\"text\" value=\"Physics\" /></td><td><input type=\"text\" value=\"Mechanics\" /></td><td><input type=\"text\" value=\"Optics\" /></td><td><input type=\"text\" value=\"Numericals\" /></td></tr>\n                            <tr><td><input type=\"text\" value=\"Chemistry\" /></td><td><input type=\"text\" value=\"Organic\" /></td><td><input type=\"text\" value=\"Inorganic\" /></td><td><input type=\"text\" value=\"Equations\" /></td></tr>\n                        </tbody>\n                    </table>\n                </div>\n                <button class=\"btn primary\" id=\"save-timetable-btn\" style=\"width:100%;\"><i class=\"fas fa-cloud-arrow-up\"></i> SAVE &amp; SYNC</button>\n                <div class=\"studio-tasks-section\" id=\"studio-tasks-section\">\n                    <h3><i class=\"fas fa-list-check\"></i> Tasks for <span id=\"studio-tasks-date-label\">Today</span></h3>\n                    <div id=\"studio-tasks-container\"></div>\n                </div>\n            </div>\n\n            <div id=\"view-calendar\" class=\"view-section\">\n                <h2><i class=\"fas fa-calendar-heart\"></i> Perfect Fitted Calendar</h2>\n                <div class=\"calendar-card\">\n                    <div class=\"calendar-header\">\n                        <button id=\"prev-month\"><i class=\"fas fa-chevron-left\"></i></button>\n                        <span id=\"calendar-month-year\">Month Year</span>\n                        <button id=\"next-month\"><i class=\"fas fa-chevron-right\"></i></button>\n                    </div>\n                    <div class=\"calendar-grid\">\n                        <div class=\"calendar-day-name\">Su</div>\n                        <div class=\"calendar-day-name\">Mo</div>\n                        <div class=\"calendar-day-name\">Tu</div>\n                        <div class=\"calendar-day-name\">We</div>\n                        <div class=\"calendar-day-name\">Th</div>\n                        <div class=\"calendar-day-name\">Fr</div>\n                        <div class=\"calendar-day-name\">Sa</div>\n                    </div>\n                    <div class=\"calendar-grid\" id=\"calendar-dates-grid\" style=\"margin-top:3px;\"></div>\n                </div>\n                <div id=\"calendar-selected-data\" style=\"margin-top:8px;\"></div>\n            </div>\n\n            <div id=\"view-analytics\" class=\"view-section\">\n                <h2><i class=\"fas fa-chart-simple\"></i> Progress Analytics</h2>\n                <div class=\"analytics-stats-row\" id=\"analytics-stats\">\n                    <div class=\"analytics-stat-box\">\n                        <div class=\"stat-value\" id=\"stat-total-days\">0</div>\n                        <div class=\"stat-label\">Days Tracked</div>\n                    </div>\n                    <div class=\"analytics-stat-box\">\n                        <div class=\"stat-value\" id=\"stat-avg-progress\">0%</div>\n                        <div class=\"stat-label\">Avg Progress</div>\n                    </div>\n                    <div class=\"analytics-stat-box\">\n                        <div class=\"stat-value\" id=\"stat-best-day\">-</div>\n                        <div class=\"stat-label\">Best Day</div>\n                    </div>\n                </div>\n                <div class=\"analytics-filters\">\n                    <button class=\"btn active\" data-filter=\"day\">Day</button>\n                    <button class=\"btn\" data-filter=\"week\">Week</button>\n                    <button class=\"btn\" data-filter=\"month\">Month</button>\n                    <button class=\"btn\" data-filter=\"all\">All</button>\n                </div>\n                <div class=\"analytics-container\" id=\"analytics-container\">\n                    <div class=\"analytics-empty\">Loading analytics...</div>\n                </div>\n                <div class=\"insights-inside\" id=\"insights-inside\">\n                    <h3><i class=\"fas fa-lightbulb\"></i> Insights</h3>\n                    <div id=\"insights-inside-container\"></div>\n                </div>\n            </div>\n\n            <div id=\"view-profile\" class=\"view-section profile-view\">\n                <div class=\"profile-page-heading\">\n                    <div><span class=\"profile-eyebrow\">YOUR ACCOUNT</span><h2><i class=\"fas fa-user-circle\"></i> Student Profile</h2><p>Manage your student details and account information.</p></div>\n                    <span class=\"profile-secure-pill\"><i class=\"fas fa-shield-halved\"></i> Private profile</span>\n                </div>\n                <section class=\"profile-hero-card\">\n                    <div class=\"profile-avatar-wrap\"><img id=\"profile-avatar\" src=\"\" alt=\"Student profile photo\"><span class=\"profile-online-dot\"></span></div>\n                    <div class=\"profile-hero-copy\"><span class=\"profile-role-label\">STUDENT ACCOUNT</span><h3 id=\"profile-hero-name\">Student</h3><p id=\"profile-hero-email\">Sign-in email</p></div>\n                    <div class=\"profile-account-chip\"><i class=\"fas fa-circle-check\"></i> <span id=\"profile-account-chip-text\">Account active</span></div>\n                </section>\n                <div class=\"profile-content-grid\">\n                    <section class=\"profile-card profile-details-card\">\n                        <div class=\"profile-card-heading\"><span class=\"profile-card-icon profile-icon-violet\"><i class=\"fas fa-id-card\"></i></span><div><h3>Personal details</h3><p>Keep your student information up to date.</p></div></div>\n                        <form id=\"student-profile-form\" class=\"profile-form\">\n                            <label for=\"profile-student-name\">Student name</label><input id=\"profile-student-name\" name=\"studentName\" type=\"text\" maxlength=\"80\" placeholder=\"Enter your name\" autocomplete=\"name\" required>\n                            <label for=\"profile-student-phone\">Phone number</label><input id=\"profile-student-phone\" name=\"studentPhone\" type=\"tel\" maxlength=\"20\" placeholder=\"Add your phone number\" autocomplete=\"tel\" inputmode=\"tel\">\n                            <p class=\"profile-form-note\"><i class=\"fas fa-circle-info\"></i> These profile details are saved on this device and do not change your Firebase sign-in details.</p>\n                            <button type=\"submit\" class=\"profile-save-btn\"><i class=\"fas fa-floppy-disk\"></i> Save profile</button>\n                            <div id=\"profile-save-feedback\" class=\"profile-save-feedback\" aria-live=\"polite\"></div>\n                        </form>\n                    </section>\n                    <section class=\"profile-card profile-account-card\">\n                        <div class=\"profile-card-heading\"><span class=\"profile-card-icon profile-icon-teal\"><i class=\"fas fa-fingerprint\"></i></span><div><h3>Account information</h3><p>Your current sign-in details.</p></div></div>\n                        <div class=\"profile-info-row\"><span>Login email</span><strong id=\"profile-info-email\">\u2014</strong></div>\n                        <div class=\"profile-info-row\"><span>Account type</span><strong id=\"profile-info-type\">\u2014</strong></div>\n                        <div class=\"profile-info-row\"><span>Sign-in provider</span><strong id=\"profile-info-provider\">\u2014</strong></div>\n                        <div class=\"profile-info-row profile-uid-row\"><span>Account ID</span><strong id=\"profile-info-uid\">\u2014</strong></div>\n                        <div class=\"profile-logout-zone\"><div><strong>Sign out</strong><p>Sign out of this account on this device.</p></div><button type=\"button\" id=\"profile-logout-btn\" class=\"profile-logout-btn\"><i class=\"fas fa-right-from-bracket\"></i> Log out</button></div>\n                    </section>\n                </div>\n            </div>\n        </main>\n\n        <button class=\"sync-btn\" id=\"force-sync-btn\" title=\"Sync Data\">\n            <i class=\"fas fa-cloud-upload-alt\"></i>\n        </button>\n        <div class=\"cloud-status\" id=\"cloud-status\">\n            <i class=\"fas fa-circle\"></i> <span id=\"cloud-status-text\">Checking...</span>\n        </div>\n\n        <nav class=\"bottom-nav\">\n            <div class=\"nav-items-row\">\n                <button class=\"nav-item active\" data-target=\"view-dashboard\"><i class=\"fas fa-layer-group\"></i><span>Dashboard</span></button>\n                <button class=\"nav-item\" data-target=\"view-today\"><i class=\"fas fa-house-chimney\"></i><span>Today</span></button>\n                <button class=\"nav-item\" data-target=\"view-yesterday\"><i class=\"fas fa-box-archive\"></i><span>History</span></button>\n                <button class=\"nav-item\" data-target=\"view-create\"><i class=\"fas fa-pen-nib\"></i><span>Studio</span></button>\n                <button class=\"nav-item\" data-target=\"view-calendar\"><i class=\"fas fa-calendar-days\"></i><span>Calendar</span></button>\n                <button class=\"nav-item\" data-target=\"view-analytics\"><i class=\"fas fa-chart-line\"></i><span>Analytics</span></button>\n                <button class=\"nav-item\" data-target=\"view-profile\"><i class=\"fas fa-user-circle\"></i><span>Profile</span></button>\n            </div>\n            <div class=\"footer-credit\">\n                Built with <span class=\"heart\">\u2764\ufe0f</span> by\n                <a href=\"https://Priyanshusingh.pages.dev/\" target=\"_blank\" rel=\"noopener noreferrer\">PRIYANSHU SINGH</a>\n            </div>\n        </nav>\n\n    </div>\n\n    <script>\n        // \u2500\u2500\u2500 PRELOADER ENTRY ANIMATION \u2500\u2500\u2500\n        // Keep the intro animation fixed in the viewport; unlock page scrolling after it ends.\n        document.body.classList.add('intro-animation-lock');\n        window.addEventListener('load', () => {\n            setTimeout(() => {\n                const preloader = document.getElementById('bwal-preloader');\n                if (preloader) preloader.style.opacity = '0';\n                setTimeout(() => {\n                    if (preloader) preloader.style.display = 'none';\n                    document.body.classList.remove('intro-animation-lock');\n                }, 600);\n            }, 7500);\n        });\n\n        // \u2500\u2500\u2500 Firebase Config \u2500\u2500\u2500\n        const firebaseConfig = {\n            apiKey: \"AIzaSyBhLhJq1MiFmILQv3xMdas12AwIxXLga60\",\n            authDomain: \"studytimetable-67ded.firebaseapp.com\",\n            projectId: \"studytimetable-67ded\",\n            storageBucket: \"studytimetable-67ded.firebasestorage.app\",\n            messagingSenderId: \"820472729807\",\n            appId: \"1:820472729807:web:9ef769bfabdf1db1dae7ba\",\n            measurementId: \"G-X4W2ZJ8YHC\"\n        };\n\n        let firebaseApp, auth, db;\n        let currentUser = null;\n        let isFirebaseReady = false;\n        let syncInProgress = false;\n        let realtimeUnsubscribe = null;\n\n        try {\n            firebaseApp = firebase.initializeApp(firebaseConfig);\n            auth = firebase.auth();\n            db = firebase.firestore();\n            db.enablePersistence({ synchronizeTabs: true }).catch(err => console.warn('Persistence:', err));\n            isFirebaseReady = true;\n        } catch (e) {\n            console.warn('Firebase init failed:', e);\n            isFirebaseReady = false;\n        }\n\n        // \u2500\u2500\u2500 DOM Refs \u2500\u2500\u2500\n        const loginOverlay = document.getElementById('login-overlay');\n        const googleBtn = document.getElementById('google-login-btn');\n        const guestBtn = document.getElementById('guest-login-btn');\n        const emailSigninBtn = document.getElementById('email-signin-btn');\n        const emailSignupBtn = document.getElementById('email-signup-btn');\n        const forgotPasswordLink = document.getElementById('forgot-password-link');\n        const emailInput = document.getElementById('email-input');\n        const passwordInput = document.getElementById('password-input');\n        const loginLoader = document.getElementById('login-loader');\n        const userBadge = document.getElementById('user-badge');\n        const userAvatar = document.getElementById('user-avatar');\n        const userNameDisplay = document.getElementById('user-name-display');\n        const userTypeBadge = document.getElementById('user-type-badge');\n        const appTitle = document.getElementById('app-title');\n        const forceSyncBtn = document.getElementById('force-sync-btn');\n        const cloudStatus = document.getElementById('cloud-status');\n        const cloudStatusText = document.getElementById('cloud-status-text');\n\n        const toast = document.getElementById('sticker-toast');\n        const toastText = document.getElementById('toast-text');\n\n        function showStickerToast(msg, icon = '\u2728') {\n            toastText.innerText = msg;\n            toast.classList.add('show');\n            clearTimeout(toast._timer);\n            toast._timer = setTimeout(() => toast.classList.remove('show'), 4000);\n        }\n\n        // \u2500\u2500\u2500 Theme \u2500\u2500\u2500\n        const themeToggle = document.getElementById('theme-toggle');\n        const themeIcon = document.getElementById('theme-icon');\n        const htmlEl = document.documentElement;\n        const savedTheme = localStorage.getItem('doodleTheme') || 'light';\n        htmlEl.setAttribute('data-theme', savedTheme);\n        themeIcon.className = savedTheme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';\n        themeToggle.addEventListener('click', () => {\n            const next = htmlEl.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';\n            htmlEl.setAttribute('data-theme', next);\n            localStorage.setItem('doodleTheme', next);\n            themeIcon.className = next === 'dark' ? 'fas fa-sun' : 'fas fa-moon';\n            renderAnalytics(currentFilter);\n            renderInsightsInside();\n        });\n\n        // \u2500\u2500\u2500 Modal \u2500\u2500\u2500\n        const modalOverlay = document.getElementById('custom-modal');\n        const modalTitle = document.getElementById('modal-title');\n        const modalContent = document.getElementById('modal-content-area');\n        const modalCancel = document.getElementById('modal-cancel-btn');\n        const modalConfirm = document.getElementById('modal-confirm-btn');\n        let modalResolve = null;\n\n        function openStickerModal(title, icon, html) {\n            return new Promise((resolve) => {\n                modalTitle.innerHTML = `<i class=\"${icon}\"></i> ${title}`;\n                modalContent.innerHTML = html;\n                modalOverlay.classList.add('active');\n                modalResolve = resolve;\n            });\n        }\n        modalCancel.addEventListener('click', () => {\n            modalOverlay.classList.remove('active');\n            if (modalResolve) modalResolve(null);\n        });\n        modalConfirm.addEventListener('click', () => {\n            modalOverlay.classList.remove('active');\n            if (modalResolve) {\n                const inputs = modalContent.querySelectorAll('input, select');\n                if (inputs.length > 1) {\n                    const vals = {};\n                    inputs.forEach(inp => vals[inp.id || inp.name] = inp.value);\n                    modalResolve(vals);\n                } else {\n                    modalResolve(inputs[0] ? inputs[0].value : true);\n                }\n            }\n        });\n\n        // \u2500\u2500\u2500 Undo Confirmation Modal \u2500\u2500\u2500\n        const undoConfirmModal = document.getElementById('undo-confirm-modal');\n        let undoResolve = null;\n\n        function showUndoConfirm(taskText) {\n            return new Promise((resolve) => {\n                document.getElementById('undo-task-text').innerHTML =\n                    `Are you sure you want to mark \"<strong>${taskText}</strong>\" as incomplete?`;\n                undoConfirmModal.classList.add('active');\n                undoResolve = resolve;\n            });\n        }\n\n        document.getElementById('undo-confirm-cancel').addEventListener('click', () => {\n            undoConfirmModal.classList.remove('active');\n            if (undoResolve) undoResolve(false);\n        });\n\n        document.getElementById('undo-confirm-yes').addEventListener('click', () => {\n            undoConfirmModal.classList.remove('active');\n            if (undoResolve) undoResolve(true);\n        });\n\n        // \u2500\u2500\u2500 Pull to Refresh Confirmation \u2500\u2500\u2500\n        const pullConfirmModal = document.getElementById('pull-confirm-modal');\n        let pullConfirmResolve = null;\n\n        function showPullConfirm() {\n            return new Promise((resolve) => {\n                pullConfirmModal.classList.add('active');\n                pullConfirmResolve = resolve;\n            });\n        }\n\n        document.getElementById('pull-confirm-cancel').addEventListener('click', () => {\n            pullConfirmModal.classList.remove('active');\n            if (pullConfirmResolve) pullConfirmResolve(false);\n        });\n\n        document.getElementById('pull-confirm-yes').addEventListener('click', () => {\n            pullConfirmModal.classList.remove('active');\n            if (pullConfirmResolve) pullConfirmResolve(true);\n        });\n\n        // \u2500\u2500\u2500 Dashboard overview (read-only summaries; original data remains untouched) \u2500\u2500\u2500\n        function renderProDashboard() {\n            const safeRead = (key, fallback) => { try { const v = JSON.parse(localStorage.getItem(key)); return v ?? fallback; } catch (_) { return fallback; } };\n            const tasksRoot = safeRead('doodleTasksData', {});\n            const todayEntry = Array.isArray(tasksRoot) ? tasksRoot.find(d => d && d.date === todayStr) : null;\n            const todayTasks = todayEntry && Array.isArray(todayEntry.tasks) ? todayEntry.tasks : (Array.isArray(tasksRoot) ? tasksRoot.filter(t => t && !t.date) : []);\n            const completed = todayTasks.filter(t => t && t.completed).length;\n            const timetables = safeRead('doodleTimetableData', []);\n            const todayPlan = Array.isArray(timetables) ? timetables.find(d => d && d.date === todayStr) : null;\n            const tests = safeRead('doodleTestsData', []);\n            const upcoming = Array.isArray(tests) ? tests.filter(t => t && t.date && t.date >= todayStr).length : 0;\n            const total = todayTasks.length;\n            const setText = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };\n            setText('dash-date-line', new Date().toLocaleDateString(undefined, {weekday:'long', month:'long', day:'numeric', year:'numeric'}));\n            setText('dash-task-total', String(total)); setText('dash-task-done', `${completed} completed`);\n            const fill = document.getElementById('dash-task-fill'); if (fill) fill.style.width = `${total ? Math.round(completed/total*100) : 0}%`;\n            setText('dash-schedule-status', todayPlan ? 'Planned' : 'Not set');\n            setText('dash-schedule-note', todayPlan ? 'Your timetable is ready for today' : 'Create a plan in Timetable Studio');\n            setText('dash-test-count', String(upcoming));\n            renderDashboardUpcomingTest(false);\n            const now = new Date(); setText('dash-clock', now.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}));\n            setText('dash-clock-date', now.toLocaleDateString([], {weekday:'short', month:'short', day:'numeric'}));\n            const preview = document.getElementById('dash-task-preview');\n            if (preview) {\n                if (!total) preview.innerHTML = '<div class=\"dash-empty\"><i class=\"fas fa-check-double\"></i><br>No tasks added for today yet.<br>Open Today to add your first priority.</div>';\n                else preview.innerHTML = todayTasks.slice(0,5).map(t => `<div class=\"dash-preview-task ${t.completed ? 'done' : ''}\"><i class=\"fas ${t.completed ? 'fa-circle-check' : 'fa-circle'}\"></i><span>${String(t.text || 'Untitled task').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]))}</span></div>`).join('') + (total > 5 ? `<div class=\"dash-empty\">+ ${total-5} more tasks in Today</div>` : '');\n            }\n        }\n        let dashboardTestIndex = 0;\n        let dashboardTestSignature = '';\n        function renderDashboardUpcomingTest(advance = false) {\n            const slide = document.getElementById('dash-upcoming-test-slide');\n            if (!slide) return;\n            let tests = [];\n            try { tests = JSON.parse(localStorage.getItem('doodleTestsData')) || []; } catch (_) { tests = []; }\n            const today = new Date();\n            const todayStr = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;\n            tests = Array.isArray(tests) ? tests.filter(t => t && t.date && t.subject && t.date >= todayStr).sort((a,b) => a.date.localeCompare(b.date)) : [];\n            const signature = tests.map(t => `${t.date}|${t.subject}`).join('||');\n            if (signature !== dashboardTestSignature) { dashboardTestSignature = signature; dashboardTestIndex = 0; }\n            else if (advance && tests.length > 1) dashboardTestIndex = (dashboardTestIndex + 1) % tests.length;\n            if (!tests.length) {\n                slide.innerHTML = '<span class=\"dash-test-slide-name\">No upcoming tests</span><small>Add a reminder below</small>';\n                return;\n            }\n            const test = tests[dashboardTestIndex % tests.length];\n            const d = new Date(`${test.date}T12:00:00`);\n            const dateLabel = d.toLocaleDateString(undefined, {weekday:'short', month:'short', day:'numeric'});\n            const safeName = String(test.subject).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n            slide.classList.remove('is-changing');\n            void slide.offsetWidth;\n            slide.classList.add('is-changing');\n            slide.innerHTML = `<span class=\"dash-test-slide-name\" title=\"${safeName}\">${safeName}</span><small><i class=\"fas fa-calendar-day\"></i> ${dateLabel} \u00b7 ${dashboardTestIndex+1}/${tests.length}</small>`;\n        }\n        setInterval(() => {\n            if (document.getElementById('view-dashboard')?.classList.contains('active')) renderDashboardUpcomingTest(true);\n        }, 4500);\n\n        function openAppView(target) {\n            const nav = document.querySelector(`.nav-item[data-target=\"${target}\"]`);\n            if (nav) nav.click();\n            if (target === 'view-dashboard') renderProDashboard();\n        }\n        document.addEventListener('click', e => { const trigger = e.target.closest('[data-go-view]'); if (trigger) openAppView(trigger.getAttribute('data-go-view')); });\n        setInterval(() => { if (document.getElementById('view-dashboard')?.classList.contains('active')) renderProDashboard(); }, 30000);\n\n        // \u2500\u2500\u2500 Navigation \u2500\u2500\u2500\n        const navItems = document.querySelectorAll('.nav-item');\n        const viewSections = document.querySelectorAll('.view-section');\n        navItems.forEach(item => {\n            item.addEventListener('click', () => {\n                navItems.forEach(n => n.classList.remove('active'));\n                item.classList.add('active');\n                const target = item.getAttribute('data-target');\n                viewSections.forEach(sec => {\n                    sec.classList.remove('active');\n                    if (sec.id === target) {\n                        sec.classList.add('active');\n                        if (target === 'view-dashboard') renderProDashboard();\n                        if (target === 'view-profile') renderStudentProfile(currentUser);\n                        if (target === 'view-calendar') renderCalendar();\n                        if (target === 'view-yesterday') {\n                            const histDate = document.getElementById('history-date-input').value;\n                            if (histDate) loadHistory(histDate);\n                        }\n                        if (target === 'view-create') {\n                            const studioDate = document.getElementById('studio-date-input').value;\n                            if (studioDate) {\n                                loadStudioTimetable(studioDate);\n                                renderStudioTasks(studioDate);\n                            }\n                        }\n                        if (target === 'view-analytics') {\n                            renderAnalytics(currentFilter);\n                            renderInsightsInside();\n                        }\n                        if (target === 'view-today') {\n                            renderTodayTasks();\n                        }\n                    }\n                });\n            });\n        });\n\n        // \u2500\u2500\u2500 Storage Keys \u2500\u2500\u2500\n        const TIMETABLE_KEY = 'doodleTimetableData';\n        const TESTS_KEY = 'doodleTestsData';\n        const TARGET_KEY = 'doodleTargetExamData';\n        const TASKS_KEY = 'doodleTasksData';\n\n        function getLocalDate(d = new Date()) {\n            const y = d.getFullYear();\n            const m = String(d.getMonth() + 1).padStart(2, '0');\n            const day = String(d.getDate()).padStart(2, '0');\n            return `${y}-${m}-${day}`;\n        }\n        const todayStr = getLocalDate();\n        document.getElementById('today-heading').innerHTML = `<i class=\"fas fa-sun\"></i> Today's Schedule (${todayStr})`;\n        const yesterday = new Date();\n        yesterday.setDate(yesterday.getDate() - 1);\n        document.getElementById('history-date-input').value = getLocalDate(yesterday);\n        document.getElementById('studio-date-input').value = todayStr;\n\n        // \u2500\u2500\u2500 Festivals DB \u2500\u2500\u2500\n        const globalFestivals = {\n            \"2024-01-01\": \"New Year's Day \ud83c\udf89\",\n            \"2024-01-14\": \"Makar Sankranti \ud83c\udf3e\",\n            \"2024-01-26\": \"Republic Day \ud83c\uddee