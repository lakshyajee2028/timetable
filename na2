ymous) syncAllToCloud();\n                                showStickerToast('\ud83d\uddd1\ufe0f Task deleted.');\n                                checkAndCelebrateAllDone(dateStr);\n                                renderAnalytics(currentFilter);\n                                renderInsightsInside();\n                            }\n                            return;\n                        }\n\n                        if (checkBtn) {\n                            e.stopPropagation();\n                            const idx = parseInt(checkBtn.dataset.idx);\n                            const tasksList = getTasksForDate(dateStr);\n                            if (tasksList[idx]) {\n                                const isCurrentlyCompleted = tasksList[idx].completed;\n\n                                if (isCurrentlyCompleted) {\n                                    const confirmed = await showUndoConfirm(tasksList[idx].text);\n                                    if (!confirmed) return;\n                                }\n\n                                tasksList[idx].completed = !tasksList[idx].completed;\n                                saveTasksForDate(dateStr, tasksList);\n                                renderTodayTasks();\n                                if (currentUser && !currentUser.isAnonymous) syncAllToCloud();\n                                if (!isCurrentlyCompleted) {\n                                    checkAndCelebrateAllDone(dateStr);\n                                } else {\n                                    showStickerToast('\u21bb Task marked as incomplete');\n                                }\n                                renderAnalytics(currentFilter);\n                                renderInsightsInside();\n                            }\n                        }\n                    });\n\n                    // Long press on task item for Today tab\n                    let longPressTimer = null;\n                    let longPressTarget = null;\n\n                    list.addEventListener('mousedown', (e) => {\n                        const target = e.target.closest('.task-item');\n                        if (!target) return;\n                        if (e.target.closest('.task-delete-btn')) return;\n                        longPressTarget = target;\n                        longPressTimer = setTimeout(async () => {\n                            const idx = parseInt(target.dataset.idx);\n                            const tasksList = getTasksForDate(dateStr);\n                            if (tasksList[idx]) {\n                                const isCurrentlyCompleted = tasksList[idx].completed;\n\n                                if (isCurrentlyCompleted) {\n                                    const confirmed = await showUndoConfirm(tasksList[idx].text);\n                                    if (!confirmed) return;\n                                }\n\n                                tasksList[idx].completed = !tasksList[idx].completed;\n                                saveTasksForDate(dateStr, tasksList);\n                                renderTodayTasks();\n                                if (currentUser && !currentUser.isAnonymous) syncAllToCloud();\n                                if (!isCurrentlyCompleted) {\n                                    checkAndCelebrateAllDone(dateStr);\n                                } else {\n                                    showStickerToast('\u21bb Task marked as incomplete');\n                                }\n                                renderAnalytics(currentFilter);\n                                renderInsightsInside();\n                                if (navigator.vibrate) navigator.vibrate(30);\n                            }\n                        }, 500);\n                    });\n\n                    list.addEventListener('mouseup', () => { clearTimeout(longPressTimer);\n                        longPressTarget = null; });\n                    list.addEventListener('mouseleave', () => { clearTimeout(longPressTimer);\n                        longPressTarget = null; });\n\n                    list.addEventListener('touchstart', (e) => {\n                        const target = e.target.closest('.task-item');\n                        if (!target) return;\n                        if (e.target.closest('.task-delete-btn')) return;\n                        longPressTarget = target;\n                        longPressTimer = setTimeout(async () => {\n                            const idx = parseInt(target.dataset.idx);\n                            const tasksList = getTasksForDate(dateStr);\n                            if (tasksList[idx]) {\n                                const isCurrentlyCompleted = tasksList[idx].completed;\n\n                                if (isCurrentlyCompleted) {\n                                    const confirmed = await showUndoConfirm(tasksList[idx].text);\n                                    if (!confirmed) return;\n                                }\n\n                                tasksList[idx].completed = !tasksList[idx].completed;\n                                saveTasksForDate(dateStr, tasksList);\n                                renderTodayTasks();\n                                if (currentUser && !currentUser.isAnonymous) syncAllToCloud();\n                                if (!isCurrentlyCompleted) {\n                                    checkAndCelebrateAllDone(dateStr);\n                                } else {\n                                    showStickerToast('\u21bb Task marked as incomplete');\n                                }\n                                renderAnalytics(currentFilter);\n                                renderInsightsInside();\n                                if (navigator.vibrate) navigator.vibrate(30);\n                            }\n                        }, 500);\n                    }, { passive: true });\n\n                    list.addEventListener('touchend', () => { clearTimeout(longPressTimer);\n                        longPressTarget = null; }, { passive: true });\n                    list.addEventListener('touchmove', () => { clearTimeout(longPressTimer);\n                        longPressTarget = null; }, { passive: true });\n                }\n            } else {\n                // Studio tab - only add and delete\n                const addBtn = document.getElementById('studio-task-add-btn');\n                const inputField = document.getElementById('studio-task-input-field');\n\n                if (addBtn && inputField) {\n                    const addTask = () => {\n                        const text = inputField.value.trim();\n                        if (!text) { showStickerToast('\u26a0\ufe0f Please enter a task.'); return; }\n                        const current = getTasksForDate(dateStr);\n                        current.push({ id: Date.now().toString(), text, completed: false });\n                        saveTasksForDate(dateStr, current);\n                        inputField.value = '';\n                        renderStudioTasks(dateStr);\n                        if (currentUser && !currentUser.isAnonymous) syncAllToCloud();\n                        showStickerToast('\u2705 Task added!');\n                    };\n                    addBtn.addEventListener('click', addTask);\n                    inputField.addEventListener('keydown', (e) => { if (e.key === 'Enter') addTask(); });\n                }\n\n                const list = document.getElementById('studio-task-list');\n                if (list) {\n                    list.addEventListener('click', (e) => {\n                        const deleteBtn = e.target.closest('.task-delete-btn');\n                        if (deleteBtn) {\n                            e.stopPropagation();\n                            const idx = parseInt(deleteBtn.dataset.idx);\n                            const tasksList = getTasksForDate(dateStr);\n                            if (tasksList[idx]) {\n                                tasksList.splice(idx, 1);\n                                saveTasksForDate(dateStr, tasksList);\n                                renderStudioTasks(dateStr);\n                                if (currentUser && !currentUser.isAnonymous) syncAllToCloud();\n                                showStickerToast('\ud83d\uddd1\ufe0f Task deleted.');\n                                checkAndCelebrateAllDone(dateStr);\n                                renderAnalytics(currentFilter);\n                                renderInsightsInside();\n                            }\n                        }\n                    });\n                }\n            }\n        }\n\n        // \u2500\u2500\u2500 TODAY'S TASKS \u2500\u2500\u2500\n        function renderTodayTasks() {\n            const container = document.getElementById('today-tasks-container');\n            renderTaskList(container, todayStr, false);\n        }\n\n        // \u2500\u2500\u2500 STUDIO TASKS \u2500\u2500\u2500\n        function renderStudioTasks(dateStr) {\n            const container = document.getElementById('studio-tasks-container');\n            const label = document.getElementById('studio-tasks-date-label');\n            if (!dateStr) {\n                dateStr = document.getElementById('studio-date-input').value;\n                if (!dateStr) { container.innerHTML = `<div class=\"no-tasks-msg\">Please select a date first.</div>`;\n                    label.innerText = '...'; return; }\n            }\n            label.innerText = dateStr;\n            renderTaskList(container, dateStr, true);\n        }\n\n        // \u2500\u2500\u2500 HISTORY with tasks \u2500\u2500\u2500\n        function loadHistory(dateVal) {\n            const container = document.getElementById('history-container');\n            const deleteArea = document.getElementById('history-delete-area');\n            const tasksContainer = document.getElementById('history-tasks-container');\n            const tasksSection = document.getElementById('history-tasks-section');\n            const data = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n            const found = data.find(d => d.date === dateVal);\n            container.innerHTML = '';\n            deleteArea.innerHTML = '';\n            if (!found) {\n                container.innerHTML = `<div class=\"card\"><p>No records for ${dateVal}.</p></div>`;\n                tasksSection.style.display = 'none';\n                return;\n            }\n            const wrapper = document.createElement('div');\n            wrapper.className = 'history-timetable-wrapper';\n            wrapper.style.position = 'relative';\n            renderTable(found, wrapper);\n            const hint = document.createElement('div');\n            hint.className = 'delete-hint';\n            hint.innerHTML = '<i class=\"fas fa-trash-can\"></i> long-press to delete';\n            wrapper.querySelector('.table-container')?.appendChild(hint);\n            container.appendChild(wrapper);\n            const btnRow = document.createElement('div');\n            btnRow.className = 'history-delete-row';\n            const delBtn = document.createElement('button');\n            delBtn.className = 'btn danger';\n            delBtn.innerHTML = '<i class=\"fas fa-trash-can\"></i> Delete this timetable';\n            delBtn.style.fontSize = '0.65rem';\n            delBtn.addEventListener('click', async (e) => {\n                e.stopPropagation();\n                await deleteTimetable(dateVal);\n            });\n            btnRow.appendChild(delBtn);\n            deleteArea.appendChild(btnRow);\n            const tableEl = wrapper.querySelector('.table-container');\n            if (tableEl) {\n                let pressTimer = null;\n                const startPress = (e) => {\n                    if (e.target.closest('input')) return;\n                    pressTimer = setTimeout(() => {\n                        tableEl.classList.add('long-press-active');\n                        if (navigator.vibrate) navigator.vibrate(30);\n                        deleteTimetable(dateVal).then(() => tableEl.classList.remove('long-press-active'));\n                    }, 550);\n                };\n                const endPress = () => { clearTimeout(pressTimer);\n                    tableEl.classList.remove('long-press-active'); };\n                tableEl.addEventListener('mousedown', startPress);\n                tableEl.addEventListener('mouseup', endPress);\n                tableEl.addEventListener('mouseleave', endPress);\n                tableEl.addEventListener('touchstart', startPress, { passive: true });\n                tableEl.addEventListener('touchend', endPress, { passive: true });\n                tableEl.addEventListener('touchmove', endPress, { passive: true });\n                tableEl.style.cursor = 'pointer';\n                tableEl.title = 'Long press to delete this timetable';\n            }\n\n            const tasks = getTasksForDate(dateVal);\n            if (tasks.length > 0) {\n                tasksSection.style.display = 'flex';\n                const completed = tasks.filter(t => t.completed).length;\n                const total = tasks.length;\n                const pct = total > 0 ? Math.round((completed / total) * 100) : 0;\n                const sortedTasks = [...tasks];\n                let tHtml = `\n                    <div class=\"task-progress-wrap\" style=\"margin-bottom:4px;\">\n                        <span style=\"font-size:0.65rem;font-weight:600;\">${completed}/${total}</span>\n                        <div class=\"task-progress-bar\"><div class=\"fill\" style=\"width:${pct}%;\"></div></div>\n                        <span class=\"task-progress-text\">${pct}%</span>\n                    </div>\n                    <ul class=\"task-list\" id=\"history-task-list\">\n                `;\n                sortedTasks.forEach(t => {\n                    tHtml += `\n                        <li class=\"task-item ${t.completed ? 'completed' : ''}\">\n                            <span class=\"task-check ${t.completed ? 'checked' : ''}\" style=\"pointer-events:none;width:18px;height:18px;font-size:0.5rem;\">\n                                <i class=\"fas ${t.completed ? 'fa-circle-check' : 'fa-circle'}\"></i>\n                            </span>\n                            <span class=\"task-text\" style=\"font-size:0.7rem;\">${t.text}</span>\n                        </li>\n                    `;\n                });\n                tHtml += `</ul>`;\n                tasksContainer.innerHTML = tHtml;\n            } else tasksSection.style.display = 'none';\n        }\n\n        document.getElementById('search-history-btn').addEventListener('click', () => {\n            const dateVal = document.getElementById('history-date-input').value;\n            if (dateVal) loadHistory(dateVal);\n        });\n\n        // \u2500\u2500\u2500 ANALYTICS \u2500\u2500\u2500\n        let currentFilter = 'day';\n\n        document.querySelectorAll('.analytics-filters .btn').forEach(btn => {\n            btn.addEventListener('click', () => {\n                document.querySelectorAll('.analytics-filters .btn').forEach(b => b.classList.remove('active'));\n                btn.classList.add('active');\n                currentFilter = btn.dataset.filter;\n                renderAnalytics(currentFilter);\n            });\n        });\n\n        function getDayName(dateStr) {\n            const d = new Date(dateStr + 'T00:00:00');\n            return d.toLocaleDateString(undefined, { weekday: 'short' });\n        }\n\n        function getDateRange(filter) {\n            const today = new Date();\n            const dates = [];\n            if (filter === 'day') {\n                const key = getLocalDate(today);\n                dates.push(key);\n            } else if (filter === 'week') {\n                const day = today.getDay();\n                const diff = today.getDate() - day + (day === 0 ? -6 : 1);\n                const monday = new Date(today);\n                monday.setDate(diff);\n                for (let i = 0; i < 7; i++) {\n                    const d = new Date(monday);\n                    d.setDate(monday.getDate() + i);\n                    dates.push(getLocalDate(d));\n                }\n            } else if (filter === 'month') {\n                const year = today.getFullYear();\n                const month = today.getMonth();\n                const daysInMonth = new Date(year, month + 1, 0).getDate();\n                for (let i = 1; i <= daysInMonth; i++) {\n                    const d = new Date(year, month, i);\n                    dates.push(getLocalDate(d));\n                }\n            } else if (filter === 'all') {\n                const allData = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n                const sorted = allData.map(d => d.date).sort();\n                sorted.forEach(date => dates.push(date));\n                if (dates.length === 0) dates.push(todayStr);\n            }\n            return dates;\n        }\n\n        function getProgressForDate(dateStr) {\n            const tasks = getTasksForDate(dateStr);\n            if (tasks.length === 0) return null;\n            const completed = tasks.filter(t => t.completed).length;\n            return Math.round((completed / tasks.length) * 100);\n        }\n\n        function renderAnalytics(filter) {\n            const container = document.getElementById('analytics-container');\n            const dateKeys = getDateRange(filter);\n            const data = [];\n            let totalProgress = 0;\n            let daysWithData = 0;\n            let bestDay = { date: '', progress: 0 };\n\n            dateKeys.forEach(key => {\n                const progress = getProgressForDate(key);\n                if (progress !== null) {\n                    data.push({ date: key, progress, dayName: getDayName(key) });\n                    totalProgress += progress;\n                    daysWithData++;\n                    if (progress > bestDay.progress) {\n                        bestDay = { date: key, progress };\n                    }\n                }\n            });\n\n            document.getElementById('stat-total-days').innerText = daysWithData;\n            document.getElementById('stat-avg-progress').innerText = daysWithData > 0 ? Math.round(totalProgress / daysWithData) +\n                '%' : '0%';\n            document.getElementById('stat-best-day').innerText = bestDay.progress > 0 ? `${bestDay.date} (${bestDay.progress}%)` :\n                '-';\n\n            if (data.length === 0) {\n                container.innerHTML =\n                    `<div class=\"analytics-empty\">\ud83d\udcca No data available. Start tracking your tasks to see progress!</div>`;\n                return;\n            }\n\n            data.sort((a, b) => a.date.localeCompare(b.date));\n\n            let html = '';\n            data.forEach((item, index) => {\n                const colorClasses = ['green', 'blue', 'purple', 'orange', 'red'];\n                const colorClass = colorClasses[index % colorClasses.length];\n                const progress = item.progress;\n\n                html += `\n                    <div class=\"analytics-card\" style=\"animation-delay: ${index * 0.05}s\">\n                        <div class=\"date-label\">\n                            <span>${item.date} <span class=\"day-name\">(${item.dayName})</span></span>\n                            <span>${progress}%</span>\n                        </div>\n                        <div class=\"analytics-bar-wrap\">\n                            <div class=\"analytics-bar-track\">\n                                <div class=\"analytics-bar-fill ${colorClass}\" style=\"width: ${progress}%;\">\n                                    ${progress > 30 ? progress + '%' : ''}\n                                </div>\n                            </div>\n                            <span class=\"analytics-percent\">${progress}%</span>\n                        </div>\n                        <div class=\"analytics-task-count\">\n                            ${getTasksForDate(item.date).length} tasks \u00b7 ${getTasksForDate(item.date).filter(t => t.completed).length} completed\n                        </div>\n                    </div>\n                `;\n            });\n\n            container.innerHTML = html;\n        }\n\n        // \u2500\u2500\u2500 INSIGHTS INSIDE ANALYTICS \u2500\u2500\u2500\n        function renderInsightsInside() {\n            const container = document.getElementById('insights-inside-container');\n            const allTasks = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n            const totalTasks = allTasks.reduce((sum, d) => sum + d.tasks.length, 0);\n            const totalCompleted = allTasks.reduce((sum, d) => sum + d.tasks.filter(t => t.completed).length, 0);\n            const totalProgress = totalTasks > 0 ? Math.round((totalCompleted / totalTasks) * 100) : 0;\n\n            const todayTasks = getTasksForDate(todayStr);\n            const todayCompleted = todayTasks.filter(t => t.completed).length;\n            const todayProgress = todayTasks.length > 0 ? Math.round((todayCompleted / todayTasks.length) * 100) : 0;\n\n            let bestDay = { date: '', progress: 0, tasks: 0 };\n            allTasks.forEach(d => {\n                const tasks = d.tasks;\n                const completed = tasks.filter(t => t.completed).length;\n                const pct = tasks.length > 0 ? Math.round((completed / tasks.length) * 100) : 0;\n                if (pct > bestDay.progress && tasks.length > 0) {\n                    bestDay = { date: d.date, progress: pct, tasks: tasks.length };\n                }\n            });\n\n            const insights = [];\n            const today = new Date();\n            const dayOfWeek = today.getDay();\n\n            if (todayTasks.length > 0) {\n                if (todayProgress === 100) {\n                    insights.push({ icon: '\ud83c\udf89', text: `Amazing! You've completed <span>all ${todayTasks.length}</span> tasks today!` });\n                } else if (todayProgress >= 70) {\n                    insights.push({ icon: '\ud83d\udd25', text: `Great progress! You're at <span>${todayProgress}%</span> for today.` });\n                } else if (todayProgress >= 40) {\n                    insights.push({ icon: '\ud83d\udcaa', text: `You're making steady progress at <span>${todayProgress}%</span>.` });\n                } else if (todayProgress > 0) {\n                    insights.push({ icon: '\ud83d\udcdd', text: `You've started with <span>${todayCompleted}/${todayTasks.length}</span> tasks done.` });\n                } else {\n                    insights.push({ icon: '\u23f0', text: `You have <span>${todayTasks.length}</span> tasks pending.` });\n                }\n            } else {\n                insights.push({ icon: '\ud83d\udccb', text: `No tasks for today. Add some to stay productive!` });\n            }\n\n            const daysWithTasks = allTasks.filter(d => d.tasks.length > 0);\n            if (daysWithTasks.length > 0) {\n                const avgProgress = daysWithTasks.reduce((sum, d) => {\n                    const tasks = d.tasks;\n                    const completed = tasks.filter(t => t.completed).length;\n                    return sum + (tasks.length > 0 ? (completed / tasks.length) * 100 : 0);\n                }, 0) / daysWithTasks.length;\n\n                if (daysWithTasks.length >= 5) {\n                    insights.push({ icon: '\ud83d\udcca', text: `Consistent for <span>${daysWithTasks.length}</span> days! Avg: <span>${Math.round(avgProgress)}%</span>` });\n                } else if (daysWithTasks.length >= 3) {\n                    insights.push({ icon: '\ud83c\udf31', text: `Tracked tasks for <span>${daysWithTasks.length}</span> days. Keep going!` });\n                }\n            }\n\n            if (bestDay.date && bestDay.progress > 0) {\n                insights.push({ icon: '\ud83c\udfc6', text: `Best day: <span>${bestDay.date}</span> with <span>${bestDay.progress}%</span> (${bestDay.tasks} tasks)` });\n            }\n\n            const motivational = [\n                \"Monday motivation! Start the week strong \ud83d\udcaa\",\n                \"Tuesday is for progress! Keep going \ud83d\ude80\",\n                \"Wednesday - halfway there! You've got this \ud83c\udf1f\",\n                \"Thursday - almost Friday! Stay focused \ud83d\udcda\",\n                \"Friday - finish strong! Reward yourself after \ud83c\udfaf\",\n                \"Saturday - great time to catch up! \ud83d\udcab\",\n                \"Sunday - relax and plan for the week ahead \ud83c\udf05\"\n            ];\n            if (dayOfWeek >= 1 && dayOfWeek <= 7) {\n                insights.push({ icon: '\ud83d\udca1', text: motivational[dayOfWeek - 1] });\n            }\n\n            if (totalTasks > 0 && totalProgress > 0) {\n                if (totalProgress >= 80) {\n                    insights.push({ icon: '\ud83c\udf1f', text: `Overall: <span>${totalProgress}%</span> (${totalCompleted}/${totalTasks})` });\n                } else if (totalProgress >= 50) {\n                    insights.push({ icon: '\ud83d\udcc8', text: `Overall progress: <span>${totalProgress}%</span> (${totalCompleted}/${totalTasks})` });\n                } else {\n                    insights.push({ icon: '\ud83c\udf31', text: `Completed <span>${totalCompleted}/${totalTasks}</span> tasks overall.` });\n                }\n            }\n\n            if (insights.length === 0) {\n                container.innerHTML = `<div class=\"no-insights-mini\">Complete some tasks to see insights! \ud83d\ude80</div>`;\n                return;\n            }\n\n            let html = '';\n            insights.slice(0, 5).forEach(insight => {\n                html += `\n                    <div class=\"insight-card-mini\">\n                        <span class=\"insight-icon\">${insight.icon}</span>\n                        <span class=\"insight-text\">${insight.text}</span>\n                    </div>\n                `;\n            });\n            container.innerHTML = html;\n        }\n\n        // \u2500\u2500\u2500 Student profile (local profile fields; Firebase auth remains untouched) \u2500\u2500\u2500\n        function profileStorageKey(user) { return `studentProfile_${(user && user.uid) || 'local'}`; }\n        function getSavedStudentProfile(user) {\n            try { return JSON.parse(localStorage.getItem(profileStorageKey(user)) || '{}') || {}; }\n            catch (_) { return {}; }\n        }\n        function renderStudentProfile(user = currentUser) {\n            const nameInput = document.getElementById('profile-student-name');\n            if (!nameInput) return;\n            const saved = getSavedStudentProfile(user);\n            const email = (user && user.email) || '';\n            const baseName = (user && user.displayName) || (email ? email.split('@')[0] : '') || (user && user.isAnonymous ? 'Guest Student' : 'Student');\n            const displayName = saved.name || baseName;\n            const avatar = document.getElementById('profile-avatar');\n            const photo = (user && user.photoURL) || `https://ui-avatars.com/api/?name=${encodeURIComponent(displayName)}&background=5659d9&color=fff&bold=true`;\n            if (avatar) { avatar.src = photo; avatar.alt = `${displayName} profile photo`; }\n            nameInput.value = displayName;\n            const phoneInput = document.getElementById('profile-student-phone');\n            if (phoneInput) phoneInput.value = saved.phone || (user && user.phoneNumber) || '';\n            const setProfileText = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value || 'Not available'; };\n            setProfileText('profile-hero-name', displayName);\n            setProfileText('profile-hero-email', email || (user && user.isAnonymous ? 'Guest account' : 'Email not connected'));\n            setProfileText('profile-info-email', email || 'Not connected');\n            setProfileText('profile-info-type', user && user.isAnonymous ? 'Guest / local' : 'Student account');\n            const provider = user && Array.isArray(user.providerData) && user.providerData.length ? user.providerData.map(p => p.providerId === 'google.com' ? 'Google' : p.providerId === 'password' ? 'Email & password' : p.providerId).join(', ') : (user && user.isAnonymous ? 'Guest mode' : 'Firebase account');\n            setProfileText('profile-info-provider', provider);\n            setProfileText('profile-info-uid', (user && user.uid) || 'Local session');\n            setProfileText('profile-account-chip-text', user && user.isAnonymous ? 'Guest session' : 'Account active');\n            const feedback = document.getElementById('profile-save-feedback');\n            if (feedback) feedback.textContent = '';\n        }\n\n        // \u2500\u2500\u2500 AUTH \u2500\u2500\u2500\n        function setUser(user) {\n            currentUser = user;\n            if (user) {\n                renderStudentProfile(user);\n                loginOverlay.classList.add('hidden');\n                userBadge.style.display = 'flex';\n                // Dashboard is the post-login landing page; all existing data handlers remain unchanged.\n                document.querySelectorAll('.nav-item').forEach(n => n.classList.toggle('active', n.getAttribute('data-target') === 'view-dashboard'));\n                document.querySelectorAll('.view-section').forEach(v => v.classList.toggle('active', v.id === 'view-dashboard'));\n                renderProDashboard();\n                userAvatar.src = user.photoURL || 'https://ui-avatars.com/api/?name=User&background=4361ee&color=fff';\n                userAvatar.alt = user.displayName || user.email || 'User';\n                let name = user.displayName || user.email || 'User';\n                if (user.isAnonymous) { name = 'Guest';\n                    userTypeBadge.style.display = 'inline'; } else userTypeBadge.style.display = 'none';\n                userNameDisplay.innerText = name.split(' ')[0] || 'User';\n                appTitle.innerText = user.isAnonymous ? '\ud83d\udcc1 GUEST MODE' : `\ud83d\udcda ${name.split(' ')[0] || 'Student'}'s T-T`;\n                showStickerToast(user.isAnonymous ? '\ud83d\udc64 Logged in as Guest' : `\ud83d\udc4b Welcome ${name}!`);\n                if (!user.isAnonymous) {\n                    // Setup real-time sync\n                    setupRealtimeSync();\n                    pullFromCloud().then(() => { refreshAllViews();\n                        updateCloudStatus('online'); });\n                } else {\n                    cleanupRealtimeSync();\n                    refreshAllViews();\n                    updateCloudStatus('offline');\n                }\n            } else {\n                cleanupRealtimeSync();\n                loginOverlay.classList.remove('hidden');\n                userBadge.style.display = 'none';\n                appTitle.innerText = 'SELF STUDY T-T';\n                updateCloudStatus('offline');\n            }\n        }\n\n        // \u2500\u2500\u2500 Sign-out \u2500\u2500\u2500\n        userBadge.addEventListener('click', async () => {\n            if (!auth || !currentUser) return;\n            const overlay = document.createElement('div');\n            overlay.className = 'modal-overlay active';\n            overlay.style.position = 'absolute';\n            overlay.style.inset = '0';\n            overlay.style.zIndex = '3000';\n            overlay.innerHTML = `\n                <div class=\"modal-box\">\n                    <h3><i class=\"fas fa-sign-out-alt\"></i> Confirm Logout</h3>\n                    <p style=\"margin-bottom:16px;\">Are you sure you want to sign out?</p>\n                    <div class=\"modal-actions\">\n                        <button class=\"btn\" id=\"temp-logout-cancel\">Cancel</button>\n                        <button class=\"btn danger\" id=\"temp-logout-confirm\">Logout</button>\n                    </div>\n                </div>\n            `;\n            document.getElementById('appContainer').appendChild(overlay);\n            const result = await new Promise((resolve) => {\n                document.getElementById('temp-logout-cancel').addEventListener('click', () => { overlay.remove();\n                    resolve(false); });\n                document.getElementById('temp-logout-confirm').addEventListener('click', async () => { overlay.remove();\n                    resolve(true); });\n            });\n            if (result) {\n                try {\n                    await auth.signOut();\n                    setUser(null);\n                    showStickerToast('\ud83d\udc4b Signed out successfully.');\n                } catch (e) { console.warn('Sign out error:', e);\n                    showStickerToast('\u26a0\ufe0f Could not sign out.'); }\n            }\n        });\n\n        // \u2500\u2500\u2500 Google Sign-In \u2500\u2500\u2500\n        googleBtn.addEventListener('click', async () => {\n            if (!isFirebaseReady) { showStickerToast('\u26a0\ufe0f Firebase not ready.'); return; }\n            loginLoader.classList.add('show');\n            googleBtn.disabled = true;\n            try {\n                const provider = new firebase.auth.GoogleAuthProvider();\n                provider.setCustomParameters({ prompt: 'select_account' });\n                const result = await auth.signInWithPopup(provider);\n                setUser(result.user);\n                const localTimetables = JSON.parse(localStorage.getItem(TIMETABLE_KEY)) || [];\n                const localTests = JSON.parse(localStorage.getItem(TESTS_KEY)) || [];\n                const localTasks = JSON.parse(localStorage.getItem(TASKS_KEY)) || [];\n                if (localTimetables.length > 0 || localTests.length > 0 || localTasks.length > 0) await syncAllToCloud();\n            } catch (e) { console.warn('Google login error:', e);\n                showStickerToast(`\u26a0\ufe0f ${e.message}`); } finally { loginLoader.classList.remove('show');\n                googleBtn.disabled = false; }\n        });\n\n        // \u2500\u2500\u2500 Guest Sign-In \u2500\u2500\u2500\n        guestBtn.addEventListener('click', async () => {\n            if (!isFirebaseReady) {\n                loginOverlay.classList.add('hidden');\n                showStickerToast(\"\ud83d\udcc1 Local mode active.\");\n                appTitle.innerText = '\ud83d\udcc1 LOCAL MODE';\n                currentUser = { isAnonymous: true, uid: 'local' };\n                refreshAllViews();\n                updateCloudStatus('offline');\n                return;\n            }\n            loginLoader.classList.add('show');\n            guestBtn.disabled = true;\n            try {\n                const result = await auth.signInAnonymously();\n                setUser(result.user);\n                showStickerToast('\ud83d\udc64 Guest mode active. Data stored locally.');\n            } catch (e) {\n                console.warn('Guest login error:', e);\n                if (e.code === 'auth/admin-restricted-operation') {\n                    loginOverlay.classList.add('hidden');\n                    showStickerToast(\"\ud83d\udcc1 Local mode active (anonymous auth disabled).\");\n                    appTitle.innerText = '\ud83d\udcc1 LOCAL MODE';\n                    currentUser = { isAnonymous: true, uid: 'local' };\n                    refreshAllViews();\n                    updateCloudStatus('offline');\n                } else showStickerToast(`\u26a0\ufe0f ${e.message}`);\n            } finally { loginLoader.classList.remove('show');\n                guestBtn.disabled = false; }\n        });\n\n        // \u2500\u25