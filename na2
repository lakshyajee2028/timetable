timer so it cannot fire again after a manual skip.\n    if (splashTimer) clearTimeout(splashTimer);\n\n    // Restore page scrolling. The splash CSS intentionally locks the body while\n    // the welcome screen is active; leaving it locked would break the app slider.\n    document.documentElement.style.overflowY = 'auto';\n    document.body.style.overflowY = 'auto';\n    document.body.style.overflowX = 'hidden';\n\n    splash.classList.add('hide');\n    appRoot.style.display = 'block';\n\n    // Re-run app initialization after app is visible.\n    initTimer = setTimeout(() => {\n      if (typeof window.__appInit === 'function') {\n        window.__appInit();\n      }\n    }, skipAnimation ? 0 : 100);\n\n    // Remove splash from DOM after fade-out.\n    removeTimer = setTimeout(() => {\n      if (splash && splash.parentNode) splash.remove();\n    }, skipAnimation ? 0 : 900);\n  }\n\n  // Normal completion after the full welcome animation.\n  splashTimer = setTimeout(() => finishSplash(false), DURATION);\n\n  // Double-tap anywhere on the welcome animation to skip it immediately.\n  splash.addEventListener('pointerup', () => {\n    const now = Date.now();\n    if (now - lastTap < 400) {\n      finishSplash(true);\n    }\n    lastTap = now;\n  }, { passive: true });\n\n  // Also support a quick double-click on desktop.\n  splash.addEventListener('dblclick', (event) => {\n    event.preventDefault();\n    finishSplash(true);\n  });\n})();\n\n/* ========== APP SCRIPT (Original Revision Centre) ========== */\nconst STORAGE_KEY = \"spaced_repetition_data\";\nconst STREAK_KEY = \"spaced_repetition_streaks\";\nconst ALERT_SETTINGS_KEY = \"alert_settings\";\nconst NOTIF_KEY = \"last_notification_date\";\nconst DRAFT_KEY = \"form_draft\";\nconst THEME_KEY = \"app_theme\";\nconst REVISION_INTERVALS = [1, 3, 7, 21];\n\nlet studyData = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];\nlet currentTab = 'add';\nlet currentActiveSubject = '';\nlet currentChemSubFilter = 'All';\nlet currentActiveChapter = '';\nlet alertDismissed = false;\n\nlet isRecording = false;\nlet recognition = null;\nlet shouldRestart = false;\n\nlet graphChartInstance = null;\nlet currentGraphRange = '7';\nlet currentGraphSubject = 'all';\nlet currentGraphView = 'combine';\nlet graphAnimateOnRender = false;\nlet currentCustomFrom = null;\nlet currentCustomTo = null;\n\n// ========== THEME ==========\nfunction loadTheme() {\n  const theme = localStorage.getItem(THEME_KEY) || 'light';\n  applyTheme(theme);\n}\nfunction applyTheme(theme) {\n  document.body.setAttribute('data-theme', theme);\n  localStorage.setItem(THEME_KEY, theme);\n  document.querySelectorAll('.theme-option').forEach(opt => {\n    opt.classList.toggle('active', opt.dataset.theme === theme);\n  });\n  if (document.getElementById('graphPage')?.classList.contains('active')) {\n    setTimeout(() => renderGraph(currentGraphRange, currentGraphSubject, currentGraphView), 100);\n  }\n}\nfunction applyPresetTheme(theme) {\n  applyTheme(theme);\n  showToast(`\ud83c\udfa8 ${theme === 'light' ? 'Light' : 'Dark'} theme applied!`);\n}\nfunction openThemeSettings() {\n  const current = localStorage.getItem(THEME_KEY) || 'light';\n  document.querySelectorAll('.theme-option').forEach(opt => {\n    opt.classList.toggle('active', opt.dataset.theme === current);\n  });\n  openModal('themeSettingsModal');\n}\n\n// ========== ALERT SETTINGS ==========\nfunction loadAlertSettings() {\n  const defaultSettings = { sound: 'default', time: '22:00' };\n  const stored = localStorage.getItem(ALERT_SETTINGS_KEY);\n  if (stored) {\n    try { return { ...defaultSettings, ...JSON.parse(stored) }; }\n    catch { return defaultSettings; }\n  }\n  return defaultSettings;\n}\nfunction saveAlertSettings(settings) { localStorage.setItem(ALERT_SETTINGS_KEY, JSON.stringify(settings)); }\nlet alertSettings = loadAlertSettings();\nfunction openAlertSettings() {\n  document.getElementById('alertSoundSelect').value = alertSettings.sound;\n  document.getElementById('alertTimeInput').value = alertSettings.time;\n  openModal('alertSettingsModal');\n}\nfunction previewSound() { playAlertSound(document.getElementById('alertSoundSelect').value); }\ndocument.getElementById('btnSaveAlertSettings').addEventListener('click', () => {\n  const sound = document.getElementById('alertSoundSelect').value;\n  const time = document.getElementById('alertTimeInput').value;\n  if (!time) { showToast('\u23f0 Select a valid time.'); return; }\n  alertSettings = { sound, time };\n  saveAlertSettings(alertSettings);\n  closeModal('alertSettingsModal');\n  showToast('\u2705 Alert settings saved!');\n});\n\n// ========== SOUND ==========\nlet currentAudioContext = null;\nlet currentOscillator = null;\nlet currentGain = null;\nfunction playAlertSound(soundType) {\n  try {\n    if (currentOscillator) { try { currentOscillator.stop(); } catch(e){} currentOscillator = null; }\n    if (currentGain) { currentGain.disconnect(); currentGain = null; }\n    if (currentAudioContext) { currentAudioContext.close(); currentAudioContext = null; }\n    const ctx = new (window.AudioContext || window.webkitAudioContext)();\n    currentAudioContext = ctx;\n    const gain = ctx.createGain();\n    gain.gain.value = 0.3;\n    currentGain = gain;\n    gain.connect(ctx.destination);\n    let oscillator = ctx.createOscillator();\n    currentOscillator = oscillator;\n    oscillator.connect(gain);\n    switch (soundType) {\n      case 'bell':\n        oscillator.type = 'sine';\n        oscillator.frequency.setValueAtTime(800, ctx.currentTime);\n        oscillator.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.1);\n        oscillator.frequency.exponentialRampToValueAtTime(600, ctx.currentTime + 0.3);\n        break;\n      case 'chime':\n        oscillator.type = 'sine';\n        oscillator.frequency.setValueAtTime(523, ctx.currentTime);\n        oscillator.frequency.setValueAtTime(659, ctx.currentTime + 0.15);\n        oscillator.frequency.setValueAtTime(784, ctx.currentTime + 0.3);\n        break;\n      case 'buzzer':\n        oscillator.type = 'square';\n        oscillator.frequency.setValueAtTime(200, ctx.currentTime);\n        break;\n      default:\n        oscillator.type = 'sine';\n        oscillator.frequency.setValueAtTime(440, ctx.currentTime);\n        oscillator.frequency.exponentialRampToValueAtTime(660, ctx.currentTime + 0.3);\n    }\n    oscillator.start(ctx.currentTime);\n    oscillator.stop(ctx.currentTime + 4);\n    gain.gain.setValueAtTime(0.3, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 3.8);\n    setTimeout(() => { try { oscillator.stop(); } catch(e){} try { ctx.close(); } catch(e){} }, 4500);\n  } catch(e) { console.warn('Sound error:', e); }\n}\n\n// ========== ALERT CHECK ==========\nfunction getPendingRevisionsToday() {\n  const todayStr = getFormattedDate(new Date());\n  let pending = [];\n  studyData.forEach(item => {\n    item.revisions.forEach((rev, idx) => {\n      if (!rev.completed && rev.date === todayStr) pending.push({ item, revIndex: idx, rev });\n    });\n  });\n  return pending;\n}\nfunction getTodayStr() { return getFormattedDate(new Date()); }\nfunction hasNotifiedToday() { return localStorage.getItem(NOTIF_KEY) === getTodayStr(); }\nfunction setNotifiedToday() { localStorage.setItem(NOTIF_KEY, getTodayStr()); }\nfunction isAlertTimeReached() {\n  const now = new Date();\n  const [hours, minutes] = alertSettings.time.split(':').map(Number);\n  const target = new Date(now);\n  target.setHours(hours, minutes, 0, 0);\n  return now >= target;\n}\nfunction checkAndNotify(manual = false) {\n  const pending = getPendingRevisionsToday();\n  const count = pending.length;\n  const timeReached = isAlertTimeReached();\n  updateBellBadge();\n  if (count === 0) {\n    document.getElementById('alertBanner').classList.remove('show');\n    alertDismissed = false;\n    return;\n  }\n  if (timeReached && (!hasNotifiedToday() || manual)) {\n    playAlertSound(alertSettings.sound);\n    if ('Notification' in window && Notification.permission === 'granted') {\n      new Notification('\u23f0 Revision Reminder', { body: `You have ${count} pending revision${count > 1 ? 's' : ''}!`, icon: '\ud83d\udcda' });\n    } else { showToast(`\u26a0\ufe0f ${count} revision${count > 1 ? 's' : ''} pending!`); }\n    setNotifiedToday();\n    if (!alertDismissed) {\n      document.getElementById('alertMsg').innerHTML = `\u23f0 You have <strong>${count}</strong> pending revision${count > 1 ? 's' : ''}.`;\n      document.getElementById('alertBanner').classList.add('show');\n    }\n  } else if (!timeReached) {\n    document.getElementById('alertBanner').classList.remove('show');\n    alertDismissed = false;\n  }\n}\nfunction updateBellBadge() {\n  const count = getPendingRevisionsToday().length;\n  const badge = document.getElementById('notifBadge');\n  if (count > 0) { badge.innerText = count; badge.classList.add('show'); }\n  else { badge.classList.remove('show'); }\n}\nfunction manualCheck() {\n  checkAndNotify(true);\n  showToast(`\ud83d\udd0d ${getPendingRevisionsToday().length} pending today.`);\n}\nfunction dismissAlert() { document.getElementById('alertBanner').classList.remove('show'); alertDismissed = true; }\nfunction startAlertChecker() {\n  setInterval(() => { checkAndNotify(false); updateDashboard(); }, 30000);\n  setTimeout(() => checkAndNotify(false), 2000);\n}\n\n// ========== INIT (called after splash) ==========\nwindow.__appInit = function() {\n  loadTheme();\n  checkAndResetStreaks();\n  renderRevisions();\n  updateDashboard();\n  updateInsightsDashboard();\n  requestNotificationPermission();\n  startAlertChecker();\n  updateBellBadge();\n  restoreFormDraft();\n  renderQuickChips();\n  setupAutoSaveDraft();\n  // Open the app on the Dashboard so progress metrics live in one dedicated place.\n  switchTab('dashboard');\n  const now = new Date();\n  const from = new Date(now);\n  from.setDate(now.getDate() - 7);\n  document.getElementById('graphDateFrom').value = getFormattedDate(from);\n  document.getElementById('graphDateTo').value = getFormattedDate(now);\n};\n\nfunction requestNotificationPermission() {\n  if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission();\n}\nfunction toggleSidebar() {\n  document.getElementById('sidebar').classList.toggle('active');\n  document.getElementById('sidebarOverlay').classList.toggle('active');\n}\nfunction autoGrowTextarea(el) {\n  el.style.height = 'auto';\n  el.style.height = Math.min(el.scrollHeight, 200) + 'px';\n}\nfunction switchTab(type) {\n  currentTab = type;\n  const slider = document.getElementById('sliderContent');\n  const addBtn = document.getElementById('addTabBtn');\n  const revBtn = document.getElementById('revTabBtn');\n  const dashboardBtn = document.getElementById('dashboardTabBtn');\n  const streakBadge = document.getElementById('streakBadge');\n  [addBtn, revBtn, dashboardBtn].forEach(btn => btn.classList.remove('active'));\n  if (type === 'add') {\n    slider.style.transform = 'translateX(0%)';\n    addBtn.classList.add('active');\n    streakBadge.className = 'streak-badge add-mode';\n  } else if (type === 'rev') {\n    slider.style.transform = 'translateX(-33.333333%)';\n    revBtn.classList.add('active');\n    streakBadge.className = 'streak-badge rev-mode';\n  } else {\n    slider.style.transform = 'translateX(-66.666667%)';\n    dashboardBtn.classList.add('active');\n    streakBadge.className = 'streak-badge add-mode';\n    updateInsightsDashboard();\n  }\n  checkAndResetStreaks();\n}\nfunction getFormattedDate(dateObj) {\n  const yyyy = dateObj.getFullYear();\n  const mm = String(dateObj.getMonth() + 1).padStart(2, '0');\n  const dd = String(dateObj.getDate()).padStart(2, '0');\n  return `${yyyy}-${mm}-${dd}`;\n}\nfunction addDays(dateStr, days) {\n  const date = new Date(dateStr);\n  date.setDate(date.getDate() + days);\n  return getFormattedDate(date);\n}\nfunction updateStreaks(mode) {\n  let streaks = JSON.parse(localStorage.getItem(STREAK_KEY)) || { add: { count: 0, lastDate: null }, rev: { count: 0, lastDate: null } };\n  const today = getFormattedDate(new Date());\n  const target = streaks[mode];\n  if (target.lastDate === today) return;\n  if (target.lastDate === addDays(today, -1)) target.count += 1;\n  else target.count = 1;\n  target.lastDate = today;\n  localStorage.setItem(STREAK_KEY, JSON.stringify(streaks));\n  checkAndResetStreaks();\n}\nfunction checkAndResetStreaks() {\n  let streaks = JSON.parse(localStorage.getItem(STREAK_KEY)) || { add: { count: 0, lastDate: null }, rev: { count: 0, lastDate: null } };\n  const today = getFormattedDate(new Date());\n  ['add', 'rev'].forEach(k => {\n    if (streaks[k].lastDate && streaks[k].lastDate !== today && streaks[k].lastDate !== addDays(today, -1)) streaks[k].count = 0;\n  });\n  localStorage.setItem(STREAK_KEY, JSON.stringify(streaks));\n  const activeVal = currentTab === 'add' ? streaks.add.count : streaks.rev.count;\n  document.getElementById('streakDisplayVal').innerText = activeVal;\n  document.getElementById('addStreakVal').innerText = `${streaks.add.count} Days`;\n  document.getElementById('revStreakVal').innerText = `${streaks.rev.count} Days`;\n}\n\n// ========== QUICK CHIPS ==========\nfunction renderQuickChips() {\n  const container = document.getElementById('quickChips');\n  const section = document.getElementById('quickSection');\n  if (!container || !section) return;\n  const recent = [...studyData].sort((a,b) => b.id - a.id)\n    .filter((v,i,arr) => arr.findIndex(x => x.chapter === v.chapter && x.subject === v.subject) === i)\n    .slice(0, 5);\n  if (recent.length === 0) { section.style.display = 'none'; return; }\n  section.style.display = 'block';\n  const today = getFormattedDate(new Date());\n  const yesterday = addDays(today, -1);\n  const yesterdayEntry = [...studyData].reverse().find(i => i.dateAdded === yesterday);\n  let html = '';\n  if (yesterdayEntry) {\n    html += `<button type=\"button\" class=\"chip chip-yesterday\" onclick=\"quickFill('${yesterdayEntry.subject}','${yesterdayEntry.chapter.replace(/'/g,\"\\\\'\")}')\">\n      <i class=\"fa-solid fa-clock-rotate-left\"></i> ${yesterdayEntry.chapter}\n    </button>`;\n  }\n  html += recent.map(r => {\n    const icon = r.subject.startsWith('Physics') ? '\u269b\ufe0f' : r.subject.startsWith('Chemistry') ? '\ud83e\uddea' : '\ud83d\udcd0';\n    const escapedCh = r.chapter.replace(/'/g, \"\\\\'\");\n    return `<button type=\"button\" class=\"chip\" onclick=\"quickFill('${r.subject}','${escapedCh}')\">${icon} ${r.chapter}</button>`;\n  }).join('');\n  container.innerHTML = html;\n}\nfunction quickFill(sub, ch) {\n  document.getElementById('subject').value = sub;\n  document.getElementById('chapter').value = ch;\n  saveDraft();\n  showToast(`\u26a1 Filled: ${ch}`);\n  document.getElementById('topics').focus();\n}\n\n// ========== SAME AS YESTERDAY ==========\nfunction openSameAsYesterdayModal() {\n  const today = getFormattedDate(new Date());\n  const yesterday = addDays(today, -1);\n  const yesterdayLogs = studyData.filter(i => i.dateAdded === yesterday);\n  if (yesterdayLogs.length === 0) {\n    showToast(`\u2139\ufe0f No logs found for yesterday.`);\n    return;\n  }\n  const container = document.getElementById('yesterdayLogsList');\n  container.innerHTML = yesterdayLogs.map(log => `\n    <div class=\"bulk-log-item\" data-id=\"${log.id}\">\n      <div class=\"bulk-checkbox\" onclick=\"toggleBulkCheck(this)\">\u2713</div>\n      <div class=\"bulk-log-info\">\n        <div class=\"bulk-log-title\">${log.subject.startsWith('Physics')?'\u269b\ufe0f':log.subject.startsWith('Chemistry')?'\ud83e\uddea':'\ud83d\udcd0'} ${log.chapter}</div>\n        <div class=\"bulk-log-meta\">Original: ${log.topics}</div>\n        <input type=\"text\" class=\"bulk-edit-topics-input\" value=\"${log.topics.replace(/\"/g,'&quot;')}\" placeholder=\"Edit topics (optional)\">\n      </div>\n    </div>\n  `).join('');\n  container.querySelectorAll('.bulk-log-item').forEach(item => {\n    const cb = item.querySelector('.bulk-checkbox');\n    cb.classList.add('checked');\n    item.classList.add('selected');\n  });\n  openModal('sameAsYesterdayModal');\n}\nfunction toggleBulkCheck(el) {\n  el.classList.toggle('checked');\n  el.closest('.bulk-log-item').classList.toggle('selected', el.classList.contains('checked'));\n}\nfunction saveSelectedYesterdayLogs() {\n  const today = getFormattedDate(new Date());\n  const yesterday = addDays(today, -1);\n  const yesterdayLogs = studyData.filter(i => i.dateAdded === yesterday);\n  const selectedIds = [];\n  document.querySelectorAll('#yesterdayLogsList .bulk-log-item').forEach(item => {\n    if (item.querySelector('.bulk-checkbox').classList.contains('checked')) {\n      selectedIds.push(parseInt(item.dataset.id));\n    }\n  });\n  if (selectedIds.length === 0) {\n    showToast('\u26a0\ufe0f Select at least one log.');\n    return;\n  }\n  let savedCount = 0;\n  yesterdayLogs.forEach(log => {\n    if (selectedIds.includes(log.id)) {\n      const itemEl = document.querySelector(`#yesterdayLogsList .bulk-log-item[data-id=\"${log.id}\"]`);\n      const editedTopics = itemEl.querySelector('.bulk-edit-topics-input').value.trim() || log.topics;\n      const revisions = REVISION_INTERVALS.map(days => ({\n        intervalDays: days,\n        date: addDays(today, days),\n        completed: false\n      }));\n      studyData.push({\n        id: Date.now() + Math.random(),\n        subject: log.subject,\n        chapter: log.chapter,\n        topics: editedTopics,\n        dateAdded: today,\n        revisions\n      });\n      savedCount++;\n    }\n  });\n  saveData();\n  if (savedCount > 0) updateStreaks('add');\n  closeModal('sameAsYesterdayModal');\n  renderQuickChips();\n  showToast(`\u2705 ${savedCount} log${savedCount > 1 ? 's' : ''} added!`);\n}\n\n// ========== VOICE INPUT ==========\nfunction toggleVoiceInput() {\n  const micBtn = document.getElementById('micBtn');\n  const indicator = document.getElementById('listeningIndicator');\n  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;\n\n  if (!SR) {\n    showToast('\u26a0\ufe0f Voice input not supported. Use Chrome or Edge.');\n    return;\n  }\n\n  if (isRecording) {\n    shouldRestart = false;\n    if (recognition) {\n      try { recognition.stop(); } catch(e){}\n    }\n    isRecording = false;\n    micBtn.classList.remove('recording');\n    indicator.classList.remove('active');\n    showToast('\ud83c\udfa4 Stopped.');\n    return;\n  }\n\n  try {\n    recognition = new SR();\n    recognition.lang = document.getElementById('voiceLangSelect').value;\n    recognition.continuous = true;\n    recognition.interimResults = true;\n    recognition.maxAlternatives = 3;\n\n    recognition.onstart = () => {\n      isRecording = true;\n      shouldRestart = true;\n      micBtn.classList.add('recording');\n      indicator.classList.add('active');\n      showToast('\ud83c\udfa4 Listening... Speak slowly');\n    };\n\n    recognition.onresult = (e) => {\n      let finalPart = '';\n      for (let i = e.resultIndex; i < e.results.length; i++) {\n        if (e.results[i].isFinal) {\n          finalPart += e.results[i][0].transcript + ' ';\n        }\n      }\n      if (finalPart) {\n        const topicsEl = document.getElementById('topics');\n        const currentText = topicsEl.value;\n        topicsEl.value = currentText ? currentText.trim() + ' ' + finalPart.trim() : finalPart.trim();\n        autoGrowTextarea(topicsEl);\n        saveDraft();\n      }\n    };\n\n    recognition.onerror = (e) => {\n      if (e.error === 'aborted') return;\n      let msg = '\u26a0\ufe0f Voice error. ';\n      if (e.error === 'not-allowed') msg += 'Please allow microphone access.';\n      else if (e.error === 'no-speech') msg += 'No speech detected. Try again.';\n      else if (e.error === 'audio-capture') msg += 'No microphone found.';\n      else if (e.error === 'network') msg += 'Network error. Check internet.';\n      else msg += 'Try again.';\n      isRecording = false;\n      shouldRestart = false;\n      micBtn.classList.remove('recording');\n      indicator.classList.remove('active');\n      showToast(msg);\n    };\n\n    recognition.onend = () => {\n      if (shouldRestart && isRecording) {\n        try {\n          recognition.start();\n          return;\n        } catch(e) {}\n      }\n      isRecording = false;\n      shouldRestart = false;\n      micBtn.classList.remove('recording');\n      indicator.classList.remove('active');\n    };\n\n    recognition.start();\n  } catch(err) {\n    isRecording = false;\n    shouldRestart = false;\n    micBtn.classList.remove('recording');\n    indicator.classList.remove('active');\n    showToast('\u26a0\ufe0f Mic not available: ' + err.message);\n  }\n}\n\n// ========== AUTO-SAVE DRAFT ==========\nfunction saveDraft() {\n  const draft = {\n    subject: document.getElementById('subject').value,\n    chapter: document.getElementById('chapter').value,\n    topics: document.getElementById('topics').value\n  };\n  localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));\n}\nfunction restoreFormDraft() {\n  try {\n    const d = JSON.parse(localStorage.getItem(DRAFT_KEY) || '{}');\n    if (d.subject) document.getElementById('subject').value = d.subject;\n    if (d.chapter) document.getElementById('chapter').value = d.chapter;\n    if (d.topics) {\n      const el = document.getElementById('topics');\n      el.value = d.topics;\n      autoGrowTextarea(el);\n    }\n  } catch(e) {}\n}\nfunction clearDraft() { localStorage.removeItem(DRAFT_KEY); }\nfunction setupAutoSaveDraft() {\n  ['subject','chapter','topics'].forEach(id => {\n    const el = document.getElementById(id);\n    if (el) {\n      el.addEventListener('input', saveDraft);\n      el.addEventListener('change', saveDraft);\n    }\n  });\n}\n\n// ========== NEW INSIGHTS DASHBOARD WIDGETS ==========\nfunction updateInsightsDashboard() {\n  const dateEl = document.getElementById('insightsDate');\n  if (!dateEl) return;\n  const today = getFormattedDate(new Date());\n  dateEl.textContent = new Date().toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();\n  const progressDateEl = document.getElementById('progressOverviewDate');\n  if (progressDateEl) progressDateEl.textContent = dateEl.textContent;\n  const streaks = JSON.parse(localStorage.getItem(STREAK_KEY)) || { add: { count: 0, lastDate: null }, rev: { count: 0, lastDate: null } };\n  const activeStreak = streaks.add && streaks.add.lastDate && [today, addDays(today, -1)].includes(streaks.add.lastDate) ? streaks.add.count : 0;\n  document.getElementById('insightStreak').textContent = `${activeStreak} ${activeStreak === 1 ? 'day' : 'days'}`;\n  document.getElementById('insightStreakSub').textContent = activeStreak ? 'Nice consistency \u2014 keep it going.' : 'Log a topic today to get started.';\n  document.getElementById('insightTotalLogs').textContent = studyData.length;\n  let due = 0, done = 0;\n  studyData.forEach(item => (item.revisions || []).forEach(rev => {\n    if (rev.date === today) { due++; if (rev.completed) done++; }\n  }));\n  document.getElementById('insightDue').textContent = due;\n  document.getElementById('insightDueSub').textContent = due ? `${Math.max(0, due - done)} still to complete` : 'No revisions scheduled for today';\n  const pct = due ? Math.round(done / due * 100) : 100;\n  document.getElementById('insightDone').textContent = `${pct}%`;\n  document.getElementById('insightDoneSub').textContent = due ? `${done} of ${due} revisions completed` : 'You are all caught up';\n  document.getElementById('insightDoneBar').style.width = `${pct}%`;\n  const days = [];\n  for (let i = 6; i >= 0; i--) {\n    const date = addDays(today, -i);\n    const count = studyData.filter(item => item.dateAdded === date).length;\n    days.push({ date, count, label: new Date(`${date}T12:00:00`).toLocaleDateString(undefined, { weekday: 'short' }).slice(0, 2) });\n  }\n  const max = Math.max(1, ...days.map(d => d.count));\n  document.getElementById('insightWeekBars').innerHTML = days.map(d => `<div class=\"week-day\" title=\"${d.date}: ${d.count} topic${d.count === 1 ? '' : 's'}\"><div class=\"week-bar-track\"><div class=\"week-bar-fill\" style=\"height:${d.count ? Math.max(8, d.count / max * 100) : 3}%\"></div></div><small>${d.label}</small></div>`).join('');\n  const totalWeek = days.reduce((sum, d) => sum + d.count, 0);\n  document.getElementById('insightWeekSummary').textContent = `${totalWeek} topic${totalWeek === 1 ? '' : 's'} logged over the last 7 days.`;\n}\n\n// ========== DASHBOARD ==========\nfunction updateDashboard() {\n  const todayStr = getFormattedDate(new Date());\n  let totalDueToday = 0, totalDoneToday = 0, overdueCount = 0;\n  let subjectStats = {\n    'Physics': { due: 0, done: 0 },\n    'Chemistry': { due: 0, done: 0 },\n    'Maths': { due: 0, done: 0 }\n  };\n  studyData.forEach(item => {\n    let mainSub = item.subject.startsWith('Chemistry') ? 'Chemistry' : item.subject;\n    item.revisions.forEach((rev) => {\n      if (rev.date === todayStr) {\n        totalDueToday++;\n        if (subjectStats[mainSub]) subjectStats[mainSub].due++;\n      }\n      if (rev.date < todayStr && !rev.completed) overdueCount++;\n      if (rev.completed && rev.date === todayStr) {\n        totalDoneToday++;\n        if (subjectStats[mainSub]) subjectStats[mainSub].done++;\n      }\n    });\n  });\n  const pct = totalDueToday > 0 ? Math.round((totalDoneToday / totalDueToday) * 100) : 100;\n  document.getElementById('overallPercent').innerText = `${pct}%`;\n  const offset = 283 - (pct / 100) * 283;\n  document.getElementById('progressCircle').style.strokeDashoffset = offset;\n  document.getElementById('statTotal').innerText = totalDueToday;\n  document.getElementById('statDone').innerText = totalDoneToday;\n  document.getElementById('statPending').innerText = overdueCount;\n  ['Physics', 'Chemistry', 'Maths'].forEach(s => {\n    const stat = subjectStats[s];\n    const prefix = s === 'Physics' ? 'phy' : s === 'Chemistry' ? 'chem' : 'math';\n    document.getElementById(`${prefix}Ratio`).innerText = `${stat.done}/${stat.due}`;\n    const barPct = stat.due > 0 ? Math.round((stat.done / stat.due) * 100) : 100;\n    document.getElementById(`${prefix}Bar`).style.width = `${barPct}%`;\n  });\n  updateBellBadge();\n  updateInsightsDashboard();\n  if (isAlertTimeReached()) checkAndNotify(false);\n}\n\n// ========== CHAPTER SUGGESTIONS ==========\nfunction handleSubjectChange() {\n  closeChapterDropdownList();\n  document.getElementById('chapter').value = '';\n  saveDraft();\n}\nfunction getChaptersForCurrentSubject() {\n  const selectedSubject = document.getElementById('subject').value;\n  const filteredItems = studyData.filter(item => item.subject === selectedSubject);\n  return [...new Set(filteredItems.map(i => i.chapter))];\n}\nfunction handleChapterInput() {\n  const inputVal = document.getElementById('chapter').value.trim().toLowerCase();\n  const chapters = getChaptersForCurrentSubject();\n  const dropdown = document.getElementById('chapterSuggestionsList');\n  if (!inputVal) { dropdown.classList.remove('active'); return; }\n  const matched = chapters.filter(c => c.toLowerCase().includes(inputVal));\n  if (matched.length === 0) { dropdown.classList.remove('active'); return; }\n  dropdown.innerHTML = matched.map(c => `<div class=\"suggestion-item\" onclick=\"selectChapterSuggestion('${c.replace(/'/g, \"\\\\'\")}')\">${c}</div>`).join('');\n  dropdown.classList.add('active');\n}\nfunction toggleChapterDropdown(e) {\n  e.stopPropagation();\n  const dropdown = document.getElementById('chapterSuggestionsList');\n  if (dropdown.classList.contains('active')) { closeChapterDropdownList(); return; }\n  const chapters = getChaptersForCurrentSubject();\n  if (chapters.length === 0) { showToast(\"\u2139\ufe0f No saved chapters yet.\"); return; }\n  dropdown.innerHTML = chapters.map(c => `<div class=\"suggestion-item\" onclick=\"selectChapterSuggestion('${c.replace(/'/g, \"\\\\'\")}')\">${c}</div>`).join('');\n  dropdown.classList.add('active');\n}\nfunction selectChapterSuggestion(chapterName) {\n  document.getElementById('chapter').value = chapterName;\n  closeChapterDropdownList();\n  saveDraft();\n}\nfunction closeChapterDropdownList() {\n  const dropdown = document.getElementById('chapterSuggestionsList');\n  if (dropdown) dropdown.classList.remove('active');\n}\nfunction handleBodyClick(e) {\n  if (!e.target.closest('.chapter-input-container')) closeChapterDropdownList();\n}\n\n// ========== FORM SUBMIT ==========\ndocument.getElementById('studyForm').addEventListener('submit', (e) => {\n  e.preventDefault();\n  const subject = document.getElementById('subject').value;\n  const chapter = document.getElementById('chapter').value.trim();\n  const topics = document.getElementById('topics').value.trim();\n  const todayStr = getFormattedDate(new Date());\n  const revisions = REVISION_INTERVALS.map(days => ({\n    intervalDays: days,\n    date: addDays(todayStr, days),\n    completed: false\n  }));\n  studyData.push({ id: Date.now(), subject, chapter, topics, dateAdded: todayStr, revisions });\n  saveData();\n  updateStreaks('add');\n  e.target.reset();\n  document.getElementById('topics').style.height = '52px';\n  clearDraft();\n  renderQuickChips();\n  showToast(\"\u2728 Topic saved successfully!\");\n  updateDashboard();\n});\n\nfunction saveData() {\n  localStorage.setItem(STORAGE_KEY, JSON.stringify(studyData));\n  renderRevisions();\n  updateDashboard();\n  if (document.getElementById('graphPage').classList.contains('active')) {\n    renderGraph(currentGraphRange, currentGraphSubject, currentGraphView);\n  }\n}\n\nfunction renderRevisions() {\n  const revList = document.getElementById('revisionList');\n  const todayStr = getFormattedDate(new Date());\n  let dueItems = [];\n  studyData.forEach(item => {\n    item.revisions.forEach((rev, index) => {\n      if (!rev.completed && rev.date <= todayStr) {\n        dueItems.push({\n          itemId: item.id, revIndex: index, subject: item.subject,\n          chapter: item.chapter, topics: item.topics, dueDate: rev.date,\n          intervalDays: rev.intervalDays, isLate: rev.date < todayStr\n        });\n      }\n    });\n  });\n  if (dueItems.length === 0) {\n    revList.innerHTML = `<div style=\"text-align:center; padding:40px 10px; color:var(--text-muted); font-weight:700;\">\ud83c\udf89 <br>All caught up!<br><span style=\"font-size:0.8rem; color:var(--text-dim);\">No revisions pending.</span></div>`;\n    return;\n  }\n  revList.innerHTML = dueItems.map(d => `\n    <div class=\"revision-card ${d.isLate ? 'late' : ''}\">\n      <div class=\"revision-info\">\n        <div class=\"revision-title\">${d.chapter} ${d.isLate ? '<span class=\"late-badge\">OVERDUE</span>' : ''}</div>\n        <div class=\"revision-topics\">${d.topics}</div>\n        <div class=\"revision-date\">\ud83d\udcc5 ${d.dueDate} \u2022 ${d.intervalDays}D Rev</div>\n      </div>\n      <button class=\"circle-check-btn ${d.isLate ? 'late-btn' : ''}\" onclick=\"completeRevision(${d.itemId}, ${d.revIndex})\" aria-label=\"Complete revision\">\u2713</button>\n    </div>\n  `).join('');\n}\nfunction completeRevision(itemId, revIndex) {\n  const item = studyData.find(i => i.id === itemId);\n  if (!item || !item.revisions[revIndex]) return;\n\n  // Mark the clicked control immediately, then update data. This avoids a\n  // visible page-wide redraw on every single revision click.\n  const btn = document.querySelector(`.circle-check-btn[onclick*=\"completeRevision(${itemId}, ${revIndex})\"]`);\n  if (btn) {\n    btn.classList.add('checked');\n    btn.disabled = true;\n  }\n\n  item.revisions[revIndex].completed = true;\n  localStorage.setItem(STORAGE_KEY, JSON.stringify(studyData));\n  updateStreaks('rev');\n  showToast(\"\ud83c\udf89 Revision complete!\");\n  checkAndNotify(false);\n\n  // Remove only the completed revision card, instead of rebuilding the entire UI.\n  if (btn) {\n    const card = btn.closest('.revision-card');\n    if (card) {\n      requestAnimationFrame(() => {\n        card.remove();\n        const revList = document.getElementById('revisionList');\n        if (revList && !revList.querySelector('.revision-card')) renderRevisions();\n      });\n    }\n  }\n}\n\n// ========== SUBJECT PAGE ==========\nfunction openSubjectPage(subjName) {\n  currentActiveSubject = subjName;\n  document.getElementById('subjectTitle').innerText = `${subjName} Chapters`;\n  const progBtn = document.getElementById('subjectProgressBtn');\n  progBtn.innerHTML = `<i class=\"fa-solid fa-chart-line\"></i> Progress`;\n  progBtn.onclick = function() { openSubjectGraph(subjName); };\n  const chemSubTabs = document.getElementById('chemSubTabs');\n  if (subjName === 'Chemistry') {\n    chemSubTabs.style.display = 'flex';\n    switchChemSub('All');\n  } else {\n    chemSubTabs.style.display = 'none';\n    renderSubjectChapters();\n  }\n  openFullscreenPage('subjectPage');\n}\nfunction closeSubjectPage() { closeFullscreenPage('subjectPage'); }\nfunction switchChemSub(type) {\n  currentChemSubFilter = type;\n  ['All', 'PC', 'OC', 'IOC'].forEach(t => {\n    const btn = document.getElementById(`chemTab${t}`);\n    if (btn) btn.classList.toggle('active', t === type);\n  });\n  renderSubjectChapters();\n}\nfunction renderSubjectChapters() {\n  const container = document.getElementById('subjectChapterList');\n  let filtered = studyData.filter(i => {\n    if (currentActiveSubject === 'Chemistry' && currentChemSubFilter !== 'All') {\n      return i.subject === `Chemistry-${currentChemSubFilter}`;\n    }\n    return i.subject.startsWith(currentActiveSubject);\n  });\n  const uniqueChapters = [...new Set(filtered.map(i => i.chapter))];\n  if (uniqueChapters.length === 0) {\n    container.innerHTML = `<div style=\"text-align:center; padding:40px; color:var(--text-muted); font-weight:700;\">No chapters found.</div>`;\n    return;\n  }\n  container.innerHTML = uniqueChapters.map(ch => {\n    const escapedCh = ch.replace(/'/g, \"\\\\'\");\n    return `<div class=\"chapter-card-item\" onclick=\"openChapterPage('${escapedCh}')\" oncontextmenu=\"event.preventDefault(); openActionModal('chapter', '${escapedCh}')\">\n      <span>\ud83d\udcd6 ${ch}</span>\n      <span style=\"color:var(--neon-blue); font-size:0.85rem; float:right;\">\u2192</span>\n    </div>`;\n  }).join('');\n}\nfunction openChapterPage(chName) {\n  currentActiveChapter = chName;\n  document.getElementById('chapterTitle').innerText = chName;\n  renderChapterTopics();\n  openFullscreenPage('chapterPage');\n}\nfunction closeChapterPage() { closeFullscreenPage('chapterPage'); }\nfunction renderChapterTopics() {\n  const container = document.getElementById('chapterTopicList');\n  const items = studyData.filter(i => i.chapter === currentActiveChapter);\n  if (items.length === 0) {\n    container.innerHTML = `<div style=\"text-align:center; padding:40px; color:var(--text-muted); font-weight:700;\">No topics found.</div>`;\n    return;\n  }\n  container.innerHTML = items.map(item => `\n    <div class=\"topic-log-card\" onclick=\"openActionModal('topic', ${item.id})\" oncontextmenu=\"event.preventDefault(); openActionModal('topic', ${item.id})\">\n      <div style=\"font-weight:800; margin-bottom:6px;\">${item.topics}</div>\n      <div style=\"font-size:0.72rem; color:var(--text-dim);\">Added: ${item.dateAdded} \u2022 ${item.subject}</div>\n    </div>\n  `).join('');\n}\nfunction openSubjectGraph(subj) {\n  if (!subj) subj = currentActiveSubject;\n  if (!subj) { showToast('\u26a0\ufe0f No subject selected.'); return; }\n  openGraphPage(subj);\n}\n\n// ========== ACTION MODALS ==========\nlet activeTargetType = '';\nlet activeTargetVal = null;\nfunction openActionModal(type, val) {\n  activeTargetType = type;\n  activeTargetVal = val;\n  const titleEl = document.getElementById('actionModalTitle');\n  const descEl = document.getElementById('actionModalDesc');\n  if (type === 'chapter') {\n    titleEl.innerText = `Manage: ${val}`;\n    descEl.innerText = \"Choose an action for this chapter.\";\n  } else {\n    titleEl.innerText = \"Manage Topic Log\";\n    descEl.innerText = \"Choose an action for this log.\";\n  }\n  document.getElementById('btnActionEdit').onclick = () => { closeModal('actionModal'); openEditModal(); };\n  document.getElementById('btnActionDelete').onclick = () => { closeModal('actionModal'); openConfirmModal(); };\n  openModal('actionModal');\n}\nfunction openEditModal() {\n  const titleEl = document.getElementById('editModalTitle');\n  const labelEl = document.getElementById('editModalLabel');\n  const inputEl = document.getElementById('editInputVal');\n  if (activeTargetType === 'chapter') {\n    titleEl.innerText = \"\u270f\ufe0f Edit Chapter\";\n    labelEl.innerText = \"Chapter Name\";\n    inputEl.value = activeTargetVal;\n  } else {\n    const topicItem = studyData.find(i => i.id === activeTargetVal);\n    titleEl.innerText = \"\u270f\ufe0f Edit Topic\";\n    labelEl.innerText = \"Topic Details\";\n    inputEl.value = topicItem ? topicItem.topics : '';\n  }\n  document.getElementById('btnSaveEdit').onclick = () => {\n    const newVal = inputEl.value.trim();\n    if (!newVal) return;\n    if (activeTargetType === 'chapter') {\n      const oldCh = activeTargetVal;\n      studyData.forEach(item => { if (item.chapter === oldCh) item.chapter = newVal; });\n      currentActiveChapter = newVal;\n      document.getElementById('chapterTitle').innerText = newVal;\n      showToast(\"\u270f\ufe0f Chapter renamed!\");\n    } else {\n      const item = studyData.find(i => i.id === activeTargetVal);\n      if (item) item.topics = newVal;\n      showToast(\"\u270f\ufe0f Topic updated!\");\n    }\n    saveData();\n    renderQuickChips();\n    closeModal('editModal');\n    if (document.getElementById('chapterPage').classList.contains('active')) renderChapterTopics();\n  };\n  openModal('editModal');\n}\nfunction openConfirmModal() {\n  const descEl = document.getElementById('confirmDeleteDesc');\n  if (activeTargetType === 'chapter') {\n    descEl.innerText = `Delete chapter '${activeTargetVal}' and all its topics?`;\n  } else {\n    descEl.innerText = \"Delete this study log entry?\";\n  }\n  document.getElementById('btnConfirmDelete').onclick = () => {\n    if (activeTargetType === 'chapter') {\n      studyData = studyData.filter(i => i.chapter !== activeTargetVal);\n      saveData();\n      closeModal('confirmModal');\n      closeChapterPage();\n      showToast(\"\ud83d\uddd1\ufe0f Chapter deleted!\");\n    } else {\n      studyData = studyData.filter(i => i.id !== activeTargetVal);\n      saveData();\n      closeModal('confirmModal');\n      if (document.getElementById('chapterPage').classList.contains('active')) renderChapterTopics();\n      showToast(\"\ud83d\uddd1\ufe0f Topic deleted!\");\n    }\n    renderQuickChips();\n  };\n  openModal('confirmModal');\n}\nfunction openModal(id) { document.getElementById(id).classList.add('active'); }\nfunction closeModal(id) { document.getElementById(id).classList.remove('active'); }\nfunction closeModalOnOuter(e, id) { if (e.target.classList.contains('modal-overlay')) closeModal(id); }\nfunction openFullscreenPage(id) {\n  const page = document.getElementById(id);\n  page.style.display = 'flex';\n  setTimeout(() => page.classList.add('active'), 5);\n}\nfunction closeFullscreenPage(id) {\n  const page = document.getElementById(id);\n  page.classList.remove('active');\n  setTimeout(() => page.style.display = 'none', 200);\n}\nfunction openStreakModal() { openModal('streakModal'); }\nfunction showToast(msg) {\n  const toast = document.getElementById('customToast');\n  toast.innerText = msg;\n  toast.classList.add('show');\n  clearTimeout(window._toastTimeout);\n  window._toastTimeout = setTimeout(() => toast.classList.remove('show'), 2200);\n}\n\n// ========== GRAPH ==========\nfunction openGraphPage(prefilterSubject) {\n  if (prefilterSubject) {\n    currentGraphSubject = prefilterSubject;\n    document.querySelectorAll('.subj-filter-btn').forEach(btn => {\n      btn.classList.toggle('active', btn.dataset.subject === prefilterSubject);\n    });\n  } else {\n    currentGraphSubject = 'all';\n    document.querySelectorAll('.subj-filter-btn').forEach(btn => {\n      btn.classList.toggle('active', btn.dataset.subject === 'all');\n    });\n  }\n  currentGraphView = 'combine';\n  updateViewButtons();\n  graphAnimateOnRender = true;\n  openFullscreenPage('graphPage');\n  setTimeout(() => {\n    renderGraph(currentGraphRange, currentGraphSubject, currentGraphView);\n    graphAnimateOnRender = false;\n  }, 150);\n}\nfunction closeGraphPage() {\n  closeFullscreenPage('graphPage');\n  if (graphChartInstance) { graphChartInstance.destroy(); graphChartInstance = null; }\n  document.getElementById('pointDetailPopup').style.display = 'none';\n}\nfunction setGraphSubject(subject) {\n  currentGraphSubject = subject;\n  document.querySelectorAll('.subj-filter-btn').forEach(btn => {\n    btn.classList.toggle('active', btn.dataset.subject === subject);\n  });\n  graphAnimateOnRender = true;\n  renderGraph(currentGraphRange, currentGraphSubject, currentGraphView);\n  graphAnimateOnRender = false;\n}\nfunction setGraphFilter(range) {\n  currentGraphRange = range;\n  document.querySelectorAll('.filter-btn').forEach(btn => {\n    btn.classList.toggle('active', btn.dataset.range === String(range));\n  });\n  if (range !== 'custom') {\n    graphAnimateOnRender = true;\n    renderGraph(range, currentGraphSubject, currentGraphView);\n    graphAnimateOnRender = false;\n  } else {\n    applyCustomDateRange();\n  }\n}\nfunction applyCustomDateRange() {\n  const fromVal = document.getElementById('graphDateFrom').value;\n  const toVal = document.getElementById('graphDateTo').value;\n  if (!fromVal || !toVal) { showToast('\u26a0\ufe0f Select both dates.'); return; }\n  if (fromVal > toVal) { showToast('\u26a0\ufe0f \"From\" must be before \"To\".'); return; }\n  currentCustomFrom = fromVal;\n  currentCustomTo = toVal;\n  currentGraphRange = 'custom';\n  document.querySelectorAll('.filter-btn').forEach(btn => {\n    btn.classList.toggle('active', btn.dataset.range === 'custom');\n  });\n  graphAnimateOnRender = true;\n  renderGraph('custom', currentGraphSubject, currentGraphView, fromVal, toVal);\n  graphAnimateOnRender = false;\n}\nfunction setGraphView(view) {\n  currentGraphView = view;\n  updateViewButtons();\n  graphAnimateOnRender = true;\n  renderGraph(currentGraphRange, currentGraphSubject, currentGraphView);\n  graphAnimateOnRender = false;\n}\nfunction updateViewButtons() {\n  const btnRev = document.getElementById('viewBtnRev');\n  const btnLog = document.getElementById('viewBtnLog');\n  const btnCombine = document.getElementById('viewBtnCombine');\n  [btnRev, btnLog, btnCombine].forEach(b => { b.className = 'view-toggle-btn'; });\n  if (currentGraphView === 'rev') btnRev.classList.add('active-rev');\n  else if (currentGraphView === 'log') btnLog.classList.add('active-log');\n  else btnCombine.classList.add('active-combine');\n}\n\nfunction renderGraph(range, subject, view, customFrom, customTo) {\n  const canvas = document.getElementById('progressChartCanvas');\n  if (!canvas) return;\n  let filteredData = studyData;\n  if (subject !== 'all') {\n    filteredData = studyData.filter(item => {\n      if (subject === 'Chemistry') return item.subject.startsWith('Chemistry');\n      return item.subject === subject;\n    });\n  }\n  let fromDate, toDate = new Date();\n  const today = new Date();\n  if (range === 'custom' && customFrom && customTo) {\n    fromDate = new Date(customFrom);\n    toDate = new Date(customTo);\n  } else if (range === 'all') {\n    let earliest = null;\n    filteredData.forEach(item => {\n      if (item.dateAdded) {\n        const d = new Date(item.dateAdded);\n        if (!earliest || d < earliest) earliest = d;\n      }\n      item.revisions.forEach(rev => {\n        if (rev.completed && rev.date) {\n          const d = new Date(rev.date);\n          if (!earliest || d < earliest) earliest = d;\n        }\n      });\n    });\n    if (!earliest) { fromDate = new Date(today); fromDate.setDate(today.getDate() - 7); }\n    else { fromDate = new Date(earliest); fromDate.setDate(fromDate.getDate() - 1); }\n    toDate = new Date(today);\n    toDate.setDate(toDate.getDate() + 1);\n  } else {\n    const days = parseInt(range);\n    fromDate = new Date(today);\n    fromDate.setDate(today.getDate() - days);\n    toDate = new Date(today);\n    toDate.setDate(toDate.getDate() + 1);\n  }\n  const dateMap = new Map();\n  const start = new Date(fromDate);\n  const end = new Date(toDate);\n  let current = new Date(start);\n  while (current <= end) {\n    const key = getFormattedDate(current);\n    dateMap.set(key, { logs: 0, revs: 0 });\n    current.setDate(current.getDate() + 1);\n  }\n  filteredData.forEach(item => {\n    if (item.dateAdded) {\n      const d = new Date(item.dateAdded);\n      if (d >= start && d <= end) {\n        const key = getFormattedDate(d);\n        if (dateMap.has(key)) dateMap.get(key).logs += 1;\n      }\n    }\n  });\n  filteredData.forEach(item => {\n    item.revisions.forEach(rev => {\n      if (rev.completed && rev.date) {\n        const d = new Date(rev.date);\n        if (d >= start && d <= end) {\n          const key = getFormattedDate(d);\n          if (dateMap.has(key)) dateMap.get(key).revs += 1;\n        }\n      }\n    });\n  });\n  const sortedDates = Array.from(dateMap.keys()).sort();\n  const labels = sortedDates;\n  const logData = sortedDates.map(d => dateMap.get(d).logs);\n  const revData = sortedDates.map(d => dateMap.get(d).revs);\n  const totalLogs = logData.reduce((a, b) => a + b, 0);\n  const totalRevs = revData.reduce((a, b) => a + b, 0);\n  const activeDays = logData.filter(v => v > 0).length + revData.filter(v => v > 0).length;\n  const bestDay = Math.max(...logData, 0);\n  document.getElementById('graphTotalLogs').innerText = totalLogs;\n  document.getElementById('graphTotalRevs').innerText = totalRevs;\n  document.getElementById('graphActiveDays').innerText = activeDays;\n  document.getElementById('graphBestDay').innerText = bestDay;\n\n  const isDark = document.body.getAttribute('data-theme') === 'dark';\n  const textColor = isDark ? '#94a3b8' : '#64748b';\n  const gridColor = isDark ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.05)';\n  const accent1 = isDark ? '#4ea8ff' : '#3b82f6';\n  const accent2 = isDark ? '#00ff87' : '#10b981';\n\n  if (totalLogs === 0 && totalRevs === 0) {\n    if (graphChartInstance) { graphChartInstance.destroy(); graphChartInstance = null; }\n    const ctx = canvas.getContext('2d');\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n    const parent = canvas.parentElement;\n    let emptyMsg = parent.querySelector('.graph-empty-msg');\n    if (!emptyMsg) {\n      emptyMsg = document.createElement('div');\n      emptyMsg.className = 'graph-empty-msg';\n      emptyMsg.innerHTML = `<i class=\"fa-regular fa-chart-bar\"></i><span>No activity data yet.<br>Start logging to see progress!</span>`;\n      parent.style.position = 'relative';\n      parent.appendChild(emptyMsg);\n    }\n    emptyMsg.style.display = 'flex';\n    canvas.style.display = 'none';\n    document.getElementById('pointDetailPopup').style.display = 'none';\n    return;\n  } else {\n    const parent = canvas.parentElement;\n    const emptyMsg = parent.querySelector('.graph-empty-msg');\n    if (emptyMsg) emptyMsg.style.display = 'none';\n    canvas.style.display = 'block';\n  }\n  const ctx = canvas.getContext('2d');\n  if (graphChartInstance) { graphChartInstance.destroy(); graphChartInstance = null; }\n  const subjectLabel = subject === 'all' ? 'All' : subject;\n  const datasets = [];\n  if (view === 'combine' || view === 'log') {\n    datasets.push({\n      label: `${subjectLabel} \u2013 Logs`, data: logData,\n      borderColor: accent2, backgroundColor: hexToRgba(accent2, 0.08),\n      fill: true, tension: 0.35,\n      pointBackgroundColor: accent2, pointBorderColor: isDark ? '#0a0e1a' : '#ffffff',\n      pointBorderWidth: 2, pointRadius: 3, pointHoverRadius: 7, borderWidth: 2.5,\n    });\n  }\n  if (view === 'combine' || view === 'rev') {\n    datasets.push({\n      label: `${subjectLabel} \u2013 Revisions`, data: revData,\n      borderColor: accent1, backgroundColor: hexToRgba(accent1, 0.08),\n      fill: true, tension: 0.35,\n      pointBackgroundColor: accent1, pointBorderColor: isDark ? '#0a0e1a' : '#ffffff',\n      pointBorderWidth: 2, pointRadius: 3, pointHoverRadius: 7, borderWidth: 2.5,\n    });\n  }\n  const animationDuration = graphAnimateOnRender ? 1200 : 0;\n  graphChartInstance = new Chart(ctx, {\n    type: 'line',\n    data: { labels, datasets },\n    options: {\n      responsive: true, maintainAspectRatio: true,\n      animation: { duration: animationDuration, easing: 'easeOutQuart' },\n      plugins: {\n        legend: {\n          labels: {\n            color: textColor,\n            font: { weight: '700', size: 11, family: \"'Plus Jakarta Sans', sans-serif\" },\n            boxWidth: 12, boxHeight: 12, padding: 16,\n            usePointStyle: true, pointStyle: 'circle',\n          }\n        },\n        tooltip: {\n          backgroundColor: isDark ? 'rgba(15, 23, 42, 0.95)' : 'rgba(255,255,255,0.98)',\n          borderColor: accent1, borderWidth: 1,\n          titleColor: isDark ? '#f8fafc' : '#1e293b',\n          bodyColor: textColor,\n          cornerRadius: 12, padding: 12,\n          callbacks: {\n            label: function(context) {\n              let label = context.dataset.label || '';\n              let val = context.parsed.y;\n              return `${label}: ${val} ${val === 1 ? 'entry' : 'entries'}`;\n            }\n          }\n        }\n      },\n      scales: {\n        x: {\n          grid: { color: gridColor, drawBorder: false },\n          ticks: {\n            color: textColor,\n            font: { size: 9, weight: '600' },\n            maxTicksLimit: 20, autoSkip: true,\n            callback: function(value, index, ticks) {\n              if (index === 0 || index === ticks.length - 1) return this.getLabelForValue(value);\n              return '';\n            }\n          }\n        },\n        y: {\n          grid: { color: gridColor, drawBorder: false },\n          ticks: { color: textColor, font: { size: 10, weight: '600' }, stepSize: 1, beginAtZero: true },\n          beginAtZero: true,\n        }\n      },\n      interaction: { intersect: false, mode: 'index' },\n      onClick: function(e, elements) {\n        if (elements.length > 0) {\n          const el = elements[0];\n          const index = el.index;\n          const date = labels[index];\n          const logs = logData[index] || 0;\n          const revs = revData[index] || 0;\n          const total = logs + revs;\n          if (total === 0) {\n            document.getElementById('pointDetailPopup').style.display = 'none';\n            return;\n          }\n          document.getElementById('popupDate').innerText = date;\n          document.getElementById('popupLogs').innerText = logs;\n          document.getElementById('popupRevs').innerText = revs;\n          document.getElementById('popupTotal').innerText = total;\n          const popup = document.getElementById('pointDetailPopup');\n          const rect = canvas.getBoundingClientRect();\n          const clickY = e.clientY - rect.top;\n          popup.style.left = '50%';\n          popup.style.top = Math.max(10, clickY - 60) + 'px';\n          popup.style.transform = 'translateX(-50%)';\n          popup.style.display = 'block';\n          return;\n        }\n        if (graphChartInstance) {\n          graphAnimateOnRender = true;\n          renderGraph(currentGraphRange, currentGraphSubject, currentGraphView);\n          graphAnimateOnRender = false;\n        }\n      }\n    }\n  });\n  canvas.onmouseleave = function() {\n    document.getElementById('pointDetailPopup').style.display = 'none';\n  };\n  const resizeHandler = () => { if (graphChartInstance) graphChartInstance.resize(); };\n  window.removeEventListener('resize', resizeHandler);\n  window.addEventListener('resize', resizeHandler);\n}\n\nfunction hexToRgba(hex, alpha) {\n  const r = parseInt(hex.slice(1, 3), 16);\n  const g = parseInt(hex.slice(3, 5), 16);\n  const b = parseInt(hex.slice(5, 7), 16);\n  return `rgba(${r}, ${g}, ${b}, ${alpha})`;\n}\n<\/script>\n</body>\n</html>\n"
};
const loaded = {timetable:false, revision:false};
function showWorkspace(name) {
  for (const key of ['timetable','revision']) {
    document.getElementById('frame-' + key).classList.toggle('active', key === name);
    const button = document.getElementById('tab-' + key);
    button.classList.toggle('active', key === name);
    button.setAttribute('aria-pressed', String(key === name));
  }
  if (!loaded[name]) {
    document.getElementById('frame-' + name).srcdoc = appDocuments[name];
    loaded[name] = true;
  }
}
document.getElementById('tab-timetable').addEventListener('click', () => showWorkspace('timetable'));
document.getElementById('tab-revision').addEventListener('click', () => showWorkspace('revision'));
showWorkspace('timetable');
</script>
